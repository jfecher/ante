type Counter =
    value: I32

increment (counter: mut Counter): Unit can Mutate 'counter =
    counter.value += 1

main () =
    print_to_stdout do
    counter = Counter 0
    increment counter
    println counter.value

impl drop_counter: Drop Counter pure with
    drop _ = ()

