import Std.Collections.HashMap
import Std.Collections.HashMap.print_hashmap, drop_hashmap
import Std.Hash.hash_u8

main () =
    print_to_stdout do
    abort_on_panic do
    var map = HashMap.empty ()
    insert map 1u8 3u16

    println (ref map)
    println (ref map)

// args: --delete-binary --no-color
// expected stdout:
// [1 -> 3]
// [1 -> 3]

