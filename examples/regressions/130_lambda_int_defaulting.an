trait Iterator it elem (effects: effect) =
    next: fn it -> Maybe (it, elem) can effects

iterate (iterable: it) (f: fn elem [env] -> Unit can e) {i: Iterator it elem effects} {Drop env e}: Unit can effects, e =
    match i.next iterable
    | None -> ()
    | Some (rest, elem) ->
        f elem
        iterate rest f

impl countdown: Iterator I32 I32 pure with
    next x =
        if x <= 0
        then None
        else Some (x - 1, x)

type TakeWhile i a =
    iter: i
    pred: fn a -> Bool

impl iter_take_while {Iterator i a e} {Copy a} {Copy i}: Iterator (TakeWhile i a) a e with
    next tw =
        match Iterator.next tw.iter
        | Some (iter, new) ->
            if tw.pred new
            then Some (TakeWhile iter tw.pred, new)
            else None
        | None -> None

main () =
    print_to_stdout do
    i = TakeWhile 8 (_ >= 5)
    iterate i println

impl drop_takewhile {Drop i d} {Drop a d}: Drop (TakeWhile i a) d with
    drop _ = ()

// args: --delete-binary --no-color
// expected stdout:
// 8
// 7
// 6
// 5

