type Shape = | Circle (radius: U32) | Square (length: U32)

area_by_field (shape: Shape): U32 =
    match shape
    | Circle radius -> 3 * radius * radius
    | Square length -> length * length

// `..c` extracts the whole matched variant as its own struct type instead.
area_by_rest (shape: Shape): U32 =
    match shape
    | Circle ..c -> 3 * c.radius * c.radius
    | Square ..s -> s.length * s.length

is_circle (shape: Shape): Bool =
    match shape
    | Circle .. -> true
    | Square .. -> false

type Pair = | Two (a: U32) (b: U32)

first (p: Pair): U32 =
    match p
    | Two a .. -> a

first_and_whole (p: Pair): U32 =
    match p
    | Two a ..w -> a + w.b

main () =
    print (area_by_field (Circle 2))
    print ", "
    println (area_by_field (Square 4))
    print (area_by_rest (Circle 2))
    print ", "
    println (area_by_rest (Square 4))

    // Shape.Circle is a struct type, constructable like any other
    c = Shape.Circle with radius = 5
    println c.radius

    // Going from Shape.Circle back to Shape currently requires an explicit reconstruction
    println (area_by_field (Circle c.radius))

    println (is_circle (Circle 2))
    println (is_circle (Square 4))
    println (first (Two 3 4))
    println (first_and_whole (Two 3 4))

// args: --delete-binary --no-color
// expected stdout:
// 12, 16
// 12, 16
// 5
// 75
// true
// false
// 3
// 7

