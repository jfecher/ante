// A `=>` return type's environment is inferred from the body, not left for each caller to choose
wrap (x: a): fn Unit => (a, I32) = fn () -> (x, 7)
outer (x: a) (y: a): fn Unit => ((a, a), I32) = wrap (x, y)

main () =
    print_to_stdout do
    f = outer 5u16 6u16
    ((a, b), c) = f ()
    println "${a} ${b} ${c}"

// args: --delete-binary --no-color
// expected stdout: 5 6 7
