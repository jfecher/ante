foo {Display I32 e} =
    println "in foo"

foo2 {Display I32 e} {Display I32 e} =
    println "in foo2"

// We should allow calling functions like `foo` with only implicit args with a ()
bar {Copy I32} =
    foo ()
    foo2 ()

main () =
    print_to_stdout do
    bar ()

// args: --delete-binary --no-color
// expected stdout:
// in foo
// in foo2
