import Std.Collections.Vec

main () =
    print_to_stdout do
    abort_on_panic do
    var v = Vec.of [1, 2, 3, 4, 5, 6]

    while pop v is Some x do
        if x == 5 then continue
        if x == 2 then break
        println x

    var v = Vec.of [1, 2, 30, 4]
    while pop v is Some x and x < 10 do
        println x

    var n = 0
    var v = Vec.of [7, 8, 9]
    while n < 2 and pop v is Some x do
        println x
        n += 1

    var a = Vec.of [1, 2, 3]
    var b = Vec.of [10, 20]
    while pop a is Some x and pop b is Some y and x + y > 0 do
        println (x + y)

// args: --delete-binary --no-color
// expected stdout:
// 6
// 4
// 3
// 4
// 9
// 8
// 23
// 12
