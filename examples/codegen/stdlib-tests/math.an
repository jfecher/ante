import Std.Math.sqrt, pow, floor, ceil, abs
import Std.Math.checked_add, checked_sub, checked_mul, checked_num_i32
import Std.Math.checked_add_i8, checked_add_i16, checked_add_i32, checked_add_i64, checked_add_isz
import Std.Math.checked_add_u8, checked_add_u16, checked_add_u32, checked_add_u64, checked_add_usz
import Std.Math.checked_sub_i8, checked_sub_i16, checked_sub_i32, checked_sub_i64, checked_sub_isz
import Std.Math.checked_sub_u8, checked_sub_u16, checked_sub_u32, checked_sub_u64, checked_sub_usz
import Std.Math.checked_mul_i8, checked_mul_i16, checked_mul_i32, checked_mul_i64, checked_mul_isz
import Std.Math.checked_mul_u8, checked_mul_u16, checked_mul_u32, checked_mul_u64, checked_mul_usz
import Std.Math.checked_num_i8, checked_num_u8, checked_num_i64, checked_num_u64
import Std.Fail.try, assert, abort_on_fail


main () =
    print_to_stdout do
    abort_on_fail do

    assert <| sqrt 16.0 == 4.0
    assert <| pow 2.0 10.0 == 1024.0
    assert <| floor 3.7 == 3.0
    assert <| ceil 3.2 == 4.0
    assert <| abs (0.0 - 7.5) == 7.5
    assert <| abs 5 == 5
    assert <| abs (0 - 12345) == 12345
    assert <| (try do checked_add_i32 2_147_483_647 1) is None
    assert <| (try do checked_add_i32 40 2) is Some 42
    assert <| (try do checked_add_i8 127i8 1i8) is None
    assert <| (try do checked_add_i16 32_767i16 1i16) is None
    assert <| (try do checked_add_i64 9_223_372_036_854_775_807i64 1i64) is None
    assert <| (try do checked_add_isz 9_223_372_036_854_775_807isz 1isz) is None
    assert <| (try do checked_add_u8 255u8 1u8) is None
    assert <| (try do checked_add_u16 65_535u16 1u16) is None
    assert <| (try do checked_add_u32 4_294_967_295u32 1u32) is None
    assert <| (try do checked_add_u64 18_446_744_073_709_551_615u64 1u64) is None
    assert <| (try do checked_add_usz 18_446_744_073_709_551_615usz 1usz) is None
    assert <| (try do checked_sub_i32 -2_147_483_648 1) is None
    assert <| (try do checked_sub_i32 40 2) is Some 38
    assert <| (try do checked_sub_i8 -128i8 1i8) is None
    assert <| (try do checked_sub_i16 -32_768i16 1i16) is None
    assert <| (try do checked_sub_i64 -9_223_372_036_854_775_808i64 1i64) is None
    assert <| (try do checked_sub_isz -9_223_372_036_854_775_808isz 1isz) is None
    assert <| (try do checked_sub_u8 0u8 1u8) is None
    assert <| (try do checked_sub_u16 0u16 1u16) is None
    assert <| (try do checked_sub_u32 0u32 1u32) is None
    assert <| (try do checked_sub_u64 0u64 1u64) is None
    assert <| (try do checked_sub_usz 0usz 1usz) is None
    assert <| (try do checked_mul_i32 50_000 50_000) is None
    assert <| (try do checked_mul_i32 -2_147_483_648 -1) is None
    assert <| (try do checked_mul_i32 -12 3) is Some (-36)
    assert <| (try do checked_mul_i8 12i8 10i8) is Some 120
    assert <| (try do checked_mul_i8 64i8 2i8) is None
    assert <| (try do checked_mul_i16 200i16 100i16) is Some 20000
    assert <| (try do checked_mul_i16 256i16 256i16) is None
    assert <| (try do checked_mul_i64 3_000_000_000i64 3_000_000_000i64) is Some 9000000000000000000
    assert <| (try do checked_mul_i64 4_000_000_000i64 4_000_000_000i64) is None
    assert <| (try do checked_mul_isz 3_000_000_000isz 3_000_000_000isz) is Some 9000000000000000000
    assert <| (try do checked_mul_isz 4_000_000_000isz 4_000_000_000isz) is None
    assert <| (try do checked_mul_u8 15u8 17u8) is Some 255
    assert <| (try do checked_mul_u8 16u8 16u8) is None
    assert <| (try do checked_mul_u16 255u16 257u16) is Some 65535
    assert <| (try do checked_mul_u16 256u16 256u16) is None
    assert <| (try do checked_mul_u32 65_535u32 65_537u32) is Some 4294967295
    assert <| (try do checked_mul_u32 65_536u32 65_536u32) is None
    assert <| (try do checked_mul_u64 4_000_000_000u64 4_000_000_000u64) is Some 16000000000000000000
    assert <| (try do checked_mul_u64 5_000_000_000u64 5_000_000_000u64) is None
    assert <| (try do checked_mul_usz 4_000_000_000usz 4_000_000_000usz) is Some 16000000000000000000
    assert <| (try do checked_mul_usz 5_000_000_000usz 5_000_000_000usz) is None
    assert <| (try do checked_add 40 2) is Some 42
    assert <| (try do checked_sub 40 2) is Some 38
    assert <| (try do checked_mul -12 3) is Some (-36)
    assert <| (try do checked_add 120i8 7i8) is Some 127
    assert <| (try do checked_add 250u8 5u8) is Some 255
    assert <| (try do checked_mul 3_000_000_000i64 3_000_000_000i64) is Some 9000000000000000000
    assert <| (try do checked_mul 4_000_000_000u64 4_000_000_000u64) is Some 16000000000000000000

// args: --delete-binary --no-color
