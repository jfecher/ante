import Std.Throw.Throw, throw, catch, catch_or, catch_or_else, map_err, unwrap_err
import Std.Fail.Fail, fail, try, assert, abort_on_fail

main () =
    abort_on_fail do

    // catch:
    assert <| ((5 + 2) ~> catch) is Ok 7
    assert <| (throw 13 ~> catch) is Error 13

    // catch_or:
    // Type annotation is needed here to not return Never, `0i32` does not fix it
    assert <| (throw 1 : I32 ~> catch_or 0) == 0
    assert <| (99 ~> catch_or 0) == 99

    // catch_or_else:
    assert <| (throw "x" : I32 ~> catch_or_else (fn _s -> 42)) == 42

    // map_err:
    assert <| (throw 5 ~> map_err (_ * 10) ~> catch) is Error 50

    // unwrap_err combined with try
    assert <| (throw 7 ~> unwrap_err ~> try) is Some 7
    assert <| (try (do unwrap_err (do 0i32)) : Maybe U64) is None

// args: --delete-binary --no-color
