import Std.IO.File, iterator_file, print_to_file, create_dir, create_dir_all
import Std.C
import Std.C.fputs, fopen, fclose, system
import Std.Fail.Fail, try, abort_on_fail, assert
import Std.String.eq_string

write_test_file (path: String): Unit can Fs, Fail =
    var f = File.open path "w"
    f.write "line1\nline2\nline3\n"
    f.close ()

test_dir (name: String): String =
    "/tmp/ante_io_test_dir" ++ name

main () =
    print_to_stdout do
    abort_on_fail do
    path = "/tmp/ante_io_test.txt"
    write_test_file (clone path)

    // Test next_char reads the first character
    f1 = File.open (clone path) "r"
    assert <| f1.next_char () == 'l'
    assert <| f1.next_char () == 'i'
    f1.close ()

    assert (try (do File.open "/nonexistent_ante_dir/missing.txt" "r") is None)

    // Test next_line reads complete lines
    var f2 = File.open (clone path) "r"
    assert <| f2.next_line () == "line1"
    assert <| f2.next_line () == "line2"
    assert <| not f2.eof ()
    assert <| f2.next_line () == "line3"

    // Iterating past the end should yield an empty string
    assert <| f2.next_line () == ""
    assert <| f2.next_line () == ""
    assert <| f2.eof ()

    // Reading a character past the end fails
    f2_ref = ref f2
    assert <| try (do f2_ref.next_char ()) is None
    f2.close ()

    // Test iterating over file lines using the File Iterator impl
    var f3 = File.open (clone path) "r"
    iterate (mut f3) println  // line1\nline2\nline3
    f3.close ()

    // Test print_to_file
    var f4 = File.open (clone path) "w"
    print_to_file f4 do
        print "printed "
        println 42
    f4.close ()

    var f5 = File.open (clone path) "r"
    assert <| f5.next_line () == "printed 42"
    f5.close ()

    // TODO: Add function to remove directories
    _ = system (C.String "rm -rf /tmp/ante_io_test_dir\0".data)
    assert <| try (do create_dir_all (test_dir "/a//b/c/")) is Some _
    assert <| try (do create_dir_all (test_dir "/a/b/c")) is Some _
    assert <| try (do create_dir (test_dir "/a")) is Some _
    // Parents are not created by create_dir
    assert <| try (do create_dir (test_dir "/missing/x")) is None
    // A file is not a directory
    assert <| try (do create_dir (clone path)) is None

// args: --delete-binary --no-color
// expected stdout:
// line1
// line2
// line3
