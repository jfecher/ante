import Std.Rc.Rc, of, as_ref, ref_count, inc_ref_count, dec_ref_count, clone_rc, drop_rc
import Std.Fail.assert, abort_on_fail
import Std.String.eq_string

main () =
    print_to_stdout do
    abort_on_fail do

    // Basic construction + as_ref + ref_count
    var rc = Rc.of 42
    assert <| ref_count rc == 1
    assert <| as_ref rc == 42

    // Clone increments ref count, both clones share storage
    rc2 = clone rc
    assert <| ref_count rc == 2

    // Manual inc/dec ref count
    inc_ref_count (mut rc)
    assert <| ref_count rc == 3
    dec_ref_count (mut rc)
    assert <| ref_count rc == 2

    // Mutate through as_ref on a uniquely-owned Rc
    var rc3 = Rc.of 7
    (as_ref rc3).* := 99
    assert <| as_ref rc3 == 99

    // try_unwrap
    rc1 = Rc.of 42i32
    assert <| Rc.try_unwrap rc1 is Ok 42

    rc2 = Rc.of 7i32
    _rc2_clone = clone rc2
    assert <| Rc.try_unwrap rc2 is Error _

    // unwrap_or_clone
    rc3 = Rc.of "hello"
    assert <| Rc.unwrap_or_clone rc3 == "hello"

    rc4 = Rc.of "world"
    _rc4_clone = clone rc4
    assert <| Rc.unwrap_or_clone rc4 == "world"

// args: --delete-binary --no-color
