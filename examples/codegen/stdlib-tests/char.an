import Std.Char.is_ascii, is_digit, is_alpha, is_alphanumeric, is_whitespace,
    to_ascii_lower, to_ascii_upper, to_digit
import Std.Fail.abort_on_fail, assert

main () =
    abort_on_fail do
    assert <| is_digit '7'
    assert <| not is_digit 'z'
    assert <| is_alpha 'A'
    assert <| not is_alpha '7'
    assert <| is_alphanumeric 'q'
    assert <| not is_alphanumeric '!'
    assert <| is_whitespace ' '
    assert <| is_whitespace '\t'
    assert <| not is_whitespace 'x'
    assert <| is_ascii 'a'
    assert <| to_ascii_lower 'X' == 'x'
    assert <| to_ascii_lower 'x' == 'x'
    assert <| to_ascii_upper 'x' == 'X'
    assert <| to_ascii_upper 'X' == 'X'
    assert <| to_digit '5' is Some 5
    assert <| to_digit 'a' is None

// args: --delete-binary --no-color
