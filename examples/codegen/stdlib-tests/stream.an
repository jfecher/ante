import Std.Stream.last
import Std.Stream.iota, enumerate, map, filter, iter, all, any, foldl, foldr,
    filter_map, reduce, map2, zip, intersperse, intersperse_with, chain, count,
    find, find_map, take, take_while, skip, skip_while, sum, product, emit
import Std.Fail.try, assert, abort_on_fail

main () =
    print_to_stdout do
    abort_on_panic do
    abort_on_fail do

    iota 10
        |> filter (fn x -> x.* %% 2)
        |> map (_ * 2)
        |> enumerate
        |> iter println

    evens = iota 10 |> map (_ * 2)
    assert <| all evens (_ %% 2)

    fold_tests ()
    extra_tests ()

// Starts at 1 so that a leading 0 element still shows up in the result
joined (stream: s) {Stream s Usz e}: Usz can e =
    foldl stream 1 (fn acc x -> acc * 100 + x)

fold_tests () =
    foldl_result = iota 5 |> map (fn x -> I64 x) |> foldl 0 (-)
    foldr_result = iota 5 |> map (fn x -> I64 x) |> foldr 0 (-)

    assert <| foldl_result == -10
    assert <| foldr_result == 2

extra_tests () =
    // any:
    assert <| any (iota 5) (_ > 3)
    assert <| not any (iota 3) (_ > 99)

    // filter_map
    assert <| iota 5
        |> filter_map (fn x -> if x %% 2 then Some (x * 10) else None)
        |> joined == 1002040

    // reduce: success + empty (wrap in try because reduce {Fail})
    assert <| try (do reduce (iota 5) (+)) is Some 10
    assert <| try (do reduce (iota 0) (+)) is None

    // map2: truncates to shorter input
    assert (map2 (iota 3) (iota 5) (+) |> joined == 1000204)

    // zip
    zip (iota 3) (iota 4)
        |> iter println                   // (0, 0), (1, 1), (2, 2)

    // intersperse:
    chain (chain (do emit "a") (do emit "b")) (do emit "c")
        |> intersperse ", "
        |> iter println

    // intersperse_with:
    assert (iota 3 |> intersperse_with (do 88) |> joined == 10088018802)

    // chain
    assert <| joined (chain (iota 2) (iota 2)) == 100010001

    // count:
    assert <| count (iota 7) == 7

    // find:
    assert <| try (do find (iota 5) (_ > 2)) is Some 3
    assert <| try (do find (iota 5) (_ > 99)) is None

    // find_map:
    assert <| (try do find_map (iota 5) (fn x -> iff (x == 3) (do x * 10))) is Some 30

    // take, take_while
    assert <| joined (iota 100 |> take 3) == 1000102
    assert <| joined (iota 100 |> take_while (_ < 3)) == 1000102

    // skip, skip_while
    assert <| iota 5 |> skip 3 |> joined == 10304
    assert <| iota 5 |> skip_while (_ < 2) |> joined == 1020304

    // sum + product
    assert <| sum (iota 5) 0 == 10
    assert <| product (iota 5 |> map (_ + 1)) 1 == 120

    var visited = 0
    for x in iota 20 do
        if x %% 3 then continue
        if x == 8 then break
        visited := visited * 10 + x
    assert <| visited == 12457

    assert <| try (do last (iota 5)) is Some 4
    assert <| try (do last (take (iota 5) 0)) is None

// args: --delete-binary --no-color
// expected stdout:
// 0, 0
// 1, 4
// 2, 8
// 3, 12
// 4, 16
// 0, 0
// 1, 1
// 2, 2
// a
// , 
// b
// , 
// c

