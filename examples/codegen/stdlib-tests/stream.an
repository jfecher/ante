import Std.Stream.last
import Std.Stream.iota, enumerate, map, filter, iter, stream_fn, all, any, foldl, foldr,
    filter_map, reduce, map2, zip, intersperse, intersperse_with, chain, count,
    find, find_map, take, take_while, skip, skip_while, sum, product, for_, Loop,
    break_, continue_, Emit, emit
import Std.Fail.Fail, try, assert, abort_on_fail

main () =
    print_to_stdout do
    abort_on_panic do
    abort_on_fail do

    iota 10
        |> filter (fn x -> x.* %% 2)
        |> map (_ * 2)
        |> enumerate
        |> iter println

    evens = iota 10 |> map (_ * 2)
    assert <| all evens (_ %% 2)

    fold_tests ()
    extra_tests ()

fold_tests () =
    foldl_result = iota 5 |> foldl 0 (-) // (((0 - 1) - 2) - 3) - 4 = -10
    foldr_result = iota 5 |> foldr 0 (-) // 0 - (1 - (2 - (3 - 4))) = 2

    // pain point: No `Cast Usz I64` nor a `TryCast Usz I64`
    assert <| (transmute foldl_result : I64) == -10
    assert <| foldr_result == 2

extra_tests () =
    // any:
    assert <| any (iota 5) (_ > 3)
    assert <| not any (iota 3) (_ > 99)

    // filter_map
    iota 5
        |> filter_map (fn x -> if x %% 2 then Some (x * 10) else None)
        |> iter println  // 0, 20, 40

    // reduce: success + empty (wrap in try because reduce {Fail})
    assert <| try (fn {f} -> reduce (iota 5) (+)) is Some 10
    assert <| try (fn {f} -> reduce (iota 0) (+)) is None

    // map2: truncates to shorter input
    map2 (iota 3) (iota 5) (+)
        |> iter println                   // 0, 2, 4

    // zip
    zip (iota 3) (iota 4)
        |> iter println                   // (0, 0), (1, 1), (2, 2)

    // intersperse:
    chain (chain (do emit "a") (do emit "b")) (do emit "c")
        |> intersperse ", "
        |> iter println

    // intersperse_with:
    iota 3
        |> intersperse_with (fn () -> 88)
        |> iter println    // 0, 88, 1, 88, 2

    // chain
    chain (iota 2) (iota 2)
        |> iter println // 0, 1, 0, 1

    // count:
    assert <| count (iota 7) == 7

    // find:
    assert <| try (do find (iota 5) (_ > 2)) is Some 3
    assert <| try (do find (iota 5) (_ > 99)) is None

    // find_map:
    assert <| (try do find_map (iota 5) (fn x -> iff (x == 3) (do x * 10))) is Some 30

    // take, take_while
    iota 100 |> take 3 |> iter println       // 0, 1, 2
    iota 100 |> take_while (_ < 3) |> iter println  // 0, 1, 2

    // skip, skip_while
    iota 5 |> skip 3 |> iter println          // 3, 4
    iota 5 |> skip_while (_ < 2) |> iter println  // 2, 3, 4

    // sum + product
    assert <| sum (iota 5) 0 == 10
    assert <| product (iota 5 |> map (_ + 1)) 1 == 120

    println "for_:"
    for_ (iota 20) fn x ->
        if x %% 3 then continue_ ()
        if x == 8 then break_ ()
        println x

    assert <| last (iota 5) is Some 4
    assert <| last (take (iota 5) 0) is None

// args: --delete-binary --no-color
// expected stdout:
// 0, 0
// 1, 4
// 2, 8
// 3, 12
// 4, 16
// 0
// 20
// 40
// 0
// 2
// 4
// 0, 0
// 1, 1
// 2, 2
// a
// , 
// b
// , 
// c
// 0
// 88
// 1
// 88
// 2
// 0
// 1
// 0
// 1
// 0
// 1
// 2
// 0
// 1
// 2
// 3
// 4
// 2
// 3
// 4
// for_:
// 1
// 2
// 4
// 5
// 7

