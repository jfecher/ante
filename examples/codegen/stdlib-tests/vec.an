import Std.Collections.Vec.is_empty, len, capacity, reserve, push, pop, get, get_unchecked,
    remove_index, remove_first, remove_indices, remove_all, swap_last
import Std.Collections.Vec

import Std.Fail.on_fail, panic_on_fail, assert, abort_on_fail
import Std.Stream.iter

main () =
    print_to_stdout do
    abort_on_panic do
    abort_on_fail do

    test_basics ()
    test_remove_first ()
    test_remove_indices ()
    test_remove_all ()
    test_swap_last ()
    test_indexing ()
    test_stream ()
    test_eq ()
    test_reverse ()
    test_swap ()
    test_insert ()
    test_dedup ()
    test_truncate_clear ()
    test_sort ()
    test_sort_by ()

test_basics () =
    var v = Vec.empty ()
    assert <| is_empty v

    push v 3i32
    push v 4
    push v 5
    remove_index v 1 ~> panic_on_fail
    assert <| v == Vec.of [3, 5]

    pop v
    assert <| v == Vec.of [3]

    assert <| ((get v 0).* ~> on_fail (do 0)) == 3
    assert <| not (is_empty v)
    assert <| len v == 1
    assert <| capacity v >= len v

    reserve v 32
    assert <| capacity v >= 32
    assert <| get_unchecked v 0 == 3

test_remove_first () =
    var v = Vec.empty ()
    push v 3
    push v 5
    push v 5
    assert <| remove_first v 5 is Some 1
    assert <| v == Vec.of [3, 5]
    assert <| remove_first v 99 is None

test_remove_indices () =
    var v = Vec.of [10, 20, 30, 40, 50]
    remove_indices v (Vec.of [1, 3]) ~> panic_on_fail
    assert <| v == Vec.of [10, 30, 50]

test_remove_all () =
    var v = Vec.of [1, 2, 1, 1, 3]
    assert <| remove_all v 1 == 3
    assert <| v == Vec.of [2, 3]

test_swap_last () =
    var v = Vec.of [10, 20, 30, 40]
    assert <| swap_last v 1
    assert <| v == Vec.of [10, 40, 30]
    assert <| not (swap_last v 2)

test_indexing () =
    v = Vec.of [10, 40, 30]
    fourty = v.[1]
    assert <| fourty == 40

test_stream () =
    v = Vec.of [7, 8, 9]
    iter (ref v) (fn (x: ref I32) -> println x.*)

test_eq () =
    assert <| Vec.of [1, 2] == Vec.of [1, 2]
    assert <| Vec.of [1, 2] != Vec.of [1, 3]

test_reverse () =
    var v = Vec.of [1, 2, 3, 4]
    reverse v
    assert <| v == Vec.of [4, 3, 2, 1]

test_swap () =
    var v = Vec.of [10, 20, 30]
    swap v 0 2 ~> panic_on_fail
    assert <| v == Vec.of [30, 20, 10]

test_insert () =
    panic_on_fail do
    var v = Vec.of [1, 3, 5]
    insert v 1 2
    insert v 3 4
    assert <| v == Vec.of [1, 2, 3, 4, 5]

test_dedup () =
    var v = Vec.of [1, 1, 2, 2, 2, 3, 1]
    dedup v
    assert <| v == Vec.of [1, 2, 3, 1]

test_truncate_clear () =
    var v = Vec.of [1, 2, 3, 4]
    truncate v 2
    assert <| v == Vec.of [1, 2]
    clear (mut v)
    assert <| is_empty v

test_sort () =
    var v = Vec.of [4, 1, 3, 2, 5]
    // `Expected Cmp _ but found Unit` when doing `v.sort ()`
    // TODO: Investigate why this happens for `v.sort ()` but not `v.dedup ()`
    sort (mut v)
    assert <| v == Vec.of [1, 2, 3, 4, 5]

test_sort_by () =
    var v = Vec.of [4, 1, 3, 2]
    sort_by v (>)
    assert <| v == Vec.of [4, 3, 2, 1]

// args: --delete-binary --no-color
// expected stdout:
// 7
// 8
// 9

