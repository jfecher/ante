import Std.Collections.Seq.module, type, impl
import Std.Stream.iota

type Tag = id: U32

impl drop_tag: Drop Tag Print with
    drop (t: Tag) =
        print "drop "
        println t.id

main () =
    print_to_stdout do
    abort_on_fail do

    var seq = Seq.empty ()
    seq := push seq 33
    seq := push seq 44

    snapshot1 = clone seq

    seq := push seq 55
    assert <| seq == Seq.of [33, 44, 55]
    assert <| snapshot1 == Seq.of [33, 44]

    assert <| push snapshot1 100 == Seq.of [33, 44, 100]
    assert <| seq == Seq.of [33, 44, 55]

    // Seq.of:
    // TODO: This type annotation shouldn't be necessary, but is
    built: Seq Usz = Seq.of (iota 5)
    assert <| built == Seq.of [0, 1, 2, 3, 4]

    // pop:
    popped_seq, popped = pop (clone built)
    assert <| popped is Some 4
    assert <| popped_seq == Seq.of [0, 1, 2, 3]

    // remove_last:
    assert <| remove_last (clone built) == Seq.of [0, 1, 2, 3]

    // get:
    assert <| get built 0 is Some 0
    assert <| get built 99 is None

    // get_copied:
    assert <| get_copied built 1u32 is Some 1

    // Regression: push used to silently overwrite the `Tag 4` slot at seq.len
    // and shrink data.len so the `Tag 5` slot was never dropped.
    println "push-overwrite regression:"
    var s = Seq.empty ()
    s := push s (Tag 1) |> push (Tag 2) |> push (Tag 3) |> push (Tag 4) |> push (Tag 5)
    var snap = clone s
    s := remove_last s
    s := remove_last s
    drop snap                                 // direct_rc 2 → 1, seq.len < data.len
    s := push s (Tag 6)                       // shadow drop fires here: drop 4, drop 5
    drop s                                    // drops Tag 1, Tag 2, Tag 3, Tag 6

// args: --delete-binary --no-color
// expected stdout:
// push-overwrite regression:
// drop 4
// drop 1
// drop 2
// drop 3
// drop 6
// drop 5

