import Std.HashMap.HashMap, empty, of, clear, insert, print_hashmap, remove, get,
    get_entry, stream_map, eq_hashmap
import Std.Stream.iter, iota, map, stream_fn, stream_array
import Std.Hash.Hash, hash_u8
import Std.Fail.try, panic_on_fail, assert, abort_on_fail

main () =
    print_to_stdout do
    abort_on_panic do
    abort_on_fail do

    var map = empty ()
    map.insert 1u8 3u16
    map.insert 2 6
    map.insert 3 9
    map.insert 4 12
    map.insert 5 15
    map.insert 6 18

    map.remove 5
    map.insert 7 21

    assert <| map == HashMap.of [(1, 3), (2, 6), (3, 9), (4, 12), (6, 18), (7, 21)]
    assert <| (map.get 3 ~> try) is Some 9
    assert <| (get map 5 ~> try) is None

    assert <| get_entry map 3 is Some _
    assert <| get_entry map 99 is None

    test_iter_and_clear ()
    test_get_or_insert_contains_and_merge ()
    test_insert_duplicate ()
    test_collision_management ()

test_iter_and_clear () =
    var single = HashMap.of [(42u8, 100u16)]
    iter single println

    // clear:
    var map = HashMap.of [(1u8, 2), (3, 4), (5, 6)]
    clear (mut map)
    assert <| map.is_empty ()
    assert <| map == HashMap.empty ()

test_get_or_insert_contains_and_merge () =
    var m = HashMap.of [(1u8, 10), (2, 20), (3, 30)]

    assert <| m.len () == 3
    assert <| not m.is_empty ()

    assert <| m.get_or_insert 1 99 == 10
    assert <| m.get_or_insert 4 40 == 40
    assert <| m.contains 4

    assert <| m.get_or_insert_with 5 (do 50) == 50

    m.retain (fn k _ -> k %% 2)
    assert <| HashMap.len m == 2

    var m2 = HashMap.of [(100u8, 1000), (200, 2000)]
    m.merge m2
    assert <| m.len() == 4

test_insert_duplicate () =
    var m = HashMap.of [(1u8, 10u16)]
    assert <| m.insert 1 99 is Some 10
    assert <| m.insert 2 20 is None
    assert <| m.len () == 2


type MyType = 
    inner: Usz

impl copy_mytype: Copy MyType with
      (.*) = deref

impl hash_mytype: Hash MyType with
    hash _ = 1

impl equal_mytype: Eq MyType pure with
    (==) x y = x.inner == y.inner

test_collision_management () =
    first = MyType 1
    second = MyType 2
        
    var m = HashMap.of [(first, 1), (second, 2)]
    // these have the same hash so should be put in the same index
    assert <| m.len () == 2

    assert <| (m.get first ~> panic_on_fail) is 1
    assert <| (m.get second ~> panic_on_fail) is 2

    // testing tombstone case
    m.remove first
    assert <| m.len () == 1
    assert <| (m.get first ~> try) is None
    assert <| (m.get second ~> panic_on_fail) is 2
    assert <| m.insert second 3 is Some 2
    assert <| (m.get second ~> panic_on_fail) is 3
    assert <| m.len () is 1


// args: --delete-binary --no-color
// expected stdout:
// 42, 100
