import Std.HashMap.clear, insert, remove, get, drop_hashmap,
    get_entry, stream_map, eq_hashmap
import Std.HashMap
import Std.Stream.iter, map
import Std.Hash.Hash, hash_u8
import Std.Fail.try, panic_on_fail, assert, abort_on_fail

main () =
    print_to_stdout do
    abort_on_panic do
    abort_on_fail do

    var map = HashMap.empty ()
    insert map 1u8 3u16
    insert map 2 6
    insert map 3 9
    insert map 4 12
    insert map 5 15
    insert map 6 18

    remove map 5
    insert map 7 21

    assert <| map == HashMap.of [(1, 3), (2, 6), (3, 9), (4, 12), (6, 18), (7, 21)]
    assert <| (get map 3 ~> try) is Some 9
    assert <| (get map 5 ~> try) is None

    assert <| get_entry map 3 is Some _
    assert <| get_entry map 99 is None

    test_iter_and_clear ()
    test_get_or_insert_contains_and_merge ()
    test_insert_duplicate ()
    test_collision_management ()

test_iter_and_clear () =
    var single = HashMap.of [(42u8, 100u16)]
    iter single println

    // clear:
    var map = HashMap.of [(1u8, 2), (3, 4), (5, 6)]
    clear (mut map)
    assert <| is_empty map
    assert <| map == HashMap.empty ()

test_get_or_insert_contains_and_merge () =
    var m = HashMap.of [(1u8, 10), (2, 20), (3, 30)]

    assert <| len m == 3
    assert <| not (is_empty m)

    assert <| get_or_insert m 1 99 == 10
    assert <| get_or_insert m 4 40 == 40
    assert <| contains m 4

    assert <| get_or_insert_with m 5 (do 50) == 50

    retain m (fn k _ -> k.* %% 2)
    assert <| len m == 2

    var m2 = HashMap.of [(100u8, 1000), (200, 2000)]
    merge m m2
    assert <| len m == 4

test_insert_duplicate () =
    var m = HashMap.of [(1u8, 10u16)]
    assert <| insert m 1 99 is Some 10
    assert <| insert m 2 20 is None
    assert <| len m == 2


type MyType = 
    inner: Usz

impl copy_mytype: Copy MyType with
      (.*) = deref

impl hash_mytype: Hash MyType with
    hash _ = 1

impl equal_mytype: Eq MyType pure with
    (==) x y = x.inner == y.inner

test_collision_management () =
    first = MyType 1
    second = MyType 2
        
    var m = HashMap.of [(first, 1), (second, 2)]
    // these have the same hash so should be put in the same index
    assert <| len m == 2

    assert <| (get m first ~> panic_on_fail) is 1
    assert <| (get m second ~> panic_on_fail) is 2

    // testing tombstone case
    remove m first
    assert <| len m == 1
    assert <| (get m first ~> try) is None
    assert <| (get m second ~> panic_on_fail) is 2
    assert <| insert m second 3 is Some 2
    assert <| (get m second ~> panic_on_fail) is 3
    assert <| len m is 1

// args: --delete-binary --no-color
// expected stdout: 42, 100
