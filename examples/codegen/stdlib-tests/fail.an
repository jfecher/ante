import Std.Fail.Fail, fail, try, on_fail, assert, ignore_fail, retry_until_success, abort_on_fail
import Std.C.malloc, free
import Std.Mem.deref_ptr, ptr_store

fail_int (): I32 can Fail = fail ()
ok_int (): I32 can Fail = 7

main () =
    print_to_stdout do
    abort_on_fail do

    // try:
    assert <| try ok_int is Some 7
    assert <| try fail_int is None

    // on_fail:
    assert <| (on_fail ok_int do 42) is 7
    assert <| (on_fail fail_int do 42) is 42

    // assert:
    ignore_fail do
        assert true
        println "asserted true"
        assert false
        println "never shown"

    // ignore_fail:
    ignore_fail fail_int
    println "ignored fail"
    ignore_fail ok_int
    println "ignored ok"

    // retry_until_success: counter in heap-allocated U32. Fails twice, then
    // succeeds on the third attempt.
    counter: Ptr U32 = malloc 4
    ptr_store counter 0u32
    val = retry_until_success do
        n = deref_ptr counter
        ptr_store counter (n + 1)
        if n < 2 then fail ()
        n

    assert (val == 2)
    free counter
    println "done"

// args: --delete-binary --no-color
// expected stdout:
// asserted true
// ignored fail
// ignored ok
// done

