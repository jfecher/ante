import Std.HashSet.HashSet, clear, contains, insert, remove, len,
    is_empty, extend, retain, merge, keys, stream_set, stream_ref_hashset,
    print_hashset, drop_hashset
import Std.HashSet
import Std.Hash.hash_u8
import Std.Stream.iter
import Std.Fail.abort_on_fail, assert

main () =
    print_to_stdout do
    abort_on_panic do
    abort_on_fail do

    test_basics ()
    test_of_extend_retain_merge ()
    test_stream_and_print ()

is_even (key: U8) = key %% 2

test_basics () =
    var set: HashSet U8 = HashSet.empty ()

    assert <| is_empty set
    assert <| len set == 0
    assert <| insert set 1
    assert <| not (insert set 1)
    assert <| contains set 1
    assert <| remove set 1
    assert <| not (remove set 1)
    assert <| is_empty set


test_of_extend_retain_merge () =
    var set = HashSet.of [1, 2, 2]
    assert <| len set == 2

    extend set [2, 3, 4]
    assert <| len set == 4

    retain set fn k -> is_even k.*
    assert <| len set == 2
    assert <| not (contains set 1)
    assert <| contains set 2
    assert <| not (contains set 3)

    other = HashSet.of [3, 5]
    merge set other
    assert <| len set == 4
    assert <| contains set 5

    clear set
    assert <| is_empty set

test_stream_and_print () =
    set = HashSet.of [42]
    iter set println

    set2 = HashSet.of [43]
    iter (ref set2) println
    iter (keys set2) println
    println set2

// args: --delete-binary --no-color
// expected stdout:
// 42
// 43
// 43
// [43]

