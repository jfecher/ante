import Std.HashSet.HashSet, empty, of, clear, contains, insert, remove, len,
    is_empty, extend, retain, merge, keys, stream_set, stream_ref_hashset,
    print_hashset
import Std.Hash.hash_u8
import Std.Stream.iter, stream_array, stream_fn
import Std.Fail.abort_on_fail, assert

main () =
    print_to_stdout do
    abort_on_panic do
    abort_on_fail do

    test_basics ()
    test_of_extend_retain_merge ()
    test_stream_and_print ()

is_even (key: U8) = key %% 2

test_basics () =
    var set: HashSet U8 = HashSet.empty ()

    assert <| set.is_empty ()
    assert <| set.len () == 0
    assert <| set.insert 1
    assert <| not set.insert 1
    assert <| set.contains 1
    assert <| set.remove 1
    assert <| not set.remove 1
    assert <| set.is_empty ()


test_of_extend_retain_merge () =
    var set = HashSet.of [1, 2, 2]
    assert <| set.len () == 2

    set.extend [2, 3, 4]
    assert <| set.len () == 4

    set.retain is_even
    assert <| set.len () == 2
    assert <| not set.contains 1
    assert <| set.contains 2
    assert <| not set.contains 3

    other = HashSet.of [3, 5]
    set.merge other
    assert <| set.len () == 4
    assert <| set.contains 5

    set.clear ()
    assert <| set.is_empty ()

test_stream_and_print () =
    set = HashSet.of [42]
    iter set println

    set2 = HashSet.of [43]
    iter (ref set2) println
    iter (HashSet.keys set2) println
    println set2

// args: --delete-binary --no-color
// expected stdout:
// 42
// 43
// 43
// [43]
