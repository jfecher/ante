effect Count =
    count: fn Unit -> Unit

foo (): Unit can Count =
    count ()
    repeat 10 fn _ -> count ()

handle_count (f: fn Unit => Unit can Count) =
    handle
        f ()
        0
    | count () ->
        1 + resume ()

main () =
    print_to_stdout do
    handle_count foo |> println

// args: --delete-binary --no-color
// expected stdout: 11
