
effect MyFail =
    fail: fn Unit -> Unit

effect Read a =
    get_input: fn Unit -> a

read_or_none (f: fn Unit => U32 can MyFail, Read U32): Maybe U32 =
    handle
        handle Some (f ())
        | get_input () -> resume 5u32
    | fail () -> None

foo (): U32 can MyFail, Read U32 =
    if false then fail ()
    get_input ()

main () =
    print_to_stdout do
    println <| read_or_none foo

// args: --delete-binary --no-color
// expected stdout: Some 5

