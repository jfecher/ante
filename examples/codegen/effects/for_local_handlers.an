// Test the local handler optimization, which turns break/continue/emit calls
// in `for` loops into direct jumps when the handlers are visible after inlining.
import Std.Stream.iota, enumerate, reduce, sum

/// Recursive, so it is never inlined: its `Loop` calls must go through a residual handle
countdown_breaking (n: Usz) (limit: Usz): Unit can Loop =
    if n == 0 then ()
    else if n == limit then break
    else countdown_breaking (n - 1) limit

/// Never inlined and calls `continue` after the first level
skip_deep (depth: Usz): Unit can Loop =
    if depth == 0 then continue
    else skip_deep (depth - 1)

main () =
    abort_on_fail do

    var total = 0
    for i in iota 100 do
        if i > 50 then break
        if i %% 2 then continue
        total += i
    assert (total == 625)

    var count = 0
    for _ in iota 10 do
        break
        count += 1
    assert (count == 0)

    // nested loops: break only exits the inner loop
    var pairs = 0
    for i in iota 5 do
        for j in iota 5 do
            if j > i then break
            pairs += 1
    assert (pairs == 15)

    // Ensure we still optimize through multiple stream adapters.
    // Difficult to test this without examining the Mir manually
    var adapted = 0
    for index, x in iota 20 |> filter (fn x -> x.* %% 3) |> map (_ * 10) |> enumerate do
        if index >= 4 then break
        assert (x == index * 30)
        adapted += 1
    assert (adapted == 4)

    // mixed: a local break plus a non-inlinable helper using Loop
    // Should still optimize the local portion
    var visited = 0
    for i in iota 10 do
        if i == 8 then break
        visited += 1
        countdown_breaking 3 (6 - i)
    assert (visited == 4)

    // non-inlinable continue
    var after = 0
    for i in iota 6 do
        if i %% 2 then skip_deep 3
        after += i
    assert (after == 1 + 3 + 5)

    // We should optimize foldl too (but foldr uses non-tail-resumes)
    count () = stream [1, 2, 3]
    sum1 = sum count 0
    sum2 = reduce count (+)
    sum3 = foldl count 0 (+)
    assert (sum1 == 6 and sum2 == 6 and sum3 == 6)

// args: --delete-binary --no-color
