effect View =
    view: fn Unit -> String

effect Write =
    write: fn String -> Unit

effect FileIO = View, Write

copy_file (): Unit can FileIO =
    view () |> write
    view () |> write

main () =
    print_to_stdout do
    handle
        handle copy_file ()
        | write s ->
          println s
          resume ()
    | view () -> resume "hello"

// args: --delete-binary --no-color
// expected stdout:
// hello
// hello
