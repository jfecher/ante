effect Read =
    read: fn Unit -> String

effect Write =
    write: fn String -> Unit

effect FileIO = Read, Write

copy_file (): Unit can FileIO =
    read () |> write
    read () |> write

main () =
    print_to_stdout do
    handle
        handle copy_file ()
        | write s ->
          println s
          resume ()
    | read () -> resume "hello"

// args: --delete-binary --no-color
// expected stdout:
// hello
// hello
