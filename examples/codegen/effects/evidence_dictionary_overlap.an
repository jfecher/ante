import Std.Stream.Stream, Emit, emit

type Pair = a: I32, b: I32

// `e` is instantiated with `Emit I32`, which the method's row already lists
impl stream_pair: Stream Pair I32 (Emit I32) with
    stream (p: Pair): Unit can Emit I32 =
        emit p.a
        emit p.b

each (s: s) {Stream s a e} (f: fn a -> Unit can Print, e): Unit can Print, e =
    handle Stream.stream s
    | emit x ->
        f x
        resume ()

main () =
    print_to_stdout do
    handle each (Pair 1 2) println
    | emit (x: I32) ->
        print "outer "
        println x
        resume ()

// args: --delete-binary --no-color
// expected stdout:
// 1
// 2

