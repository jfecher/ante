import Std.HashMap.HashMap
import Std.Hash.hash_u8
import Std.HashMap

// The map's `Hash` impl is omitted from the return type so it is inferred from the body
build (): HashMap U8 I32 can Panic =
    var map = HashMap.empty ()
    ignore (insert map 1 2)
    ignore (insert map 3 4)
    map

main () =
    print_to_stdout do
    abort_on_panic do
    map = build ()
    println map.len

// args: --delete-binary --no-color
// expected stdout: 2
