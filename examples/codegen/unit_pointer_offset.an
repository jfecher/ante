import Std.Stream.iter
import Std.Mem.Type, MkType, size_of
import Std.Collections.Vec

type MyType =
    key: U8
    idk: Unit
    aboolean: Bool
    tombstone: Bool

print_mytype (res: ref MyType) =
    print res.key
    print ", "
    println res.aboolean

main () =
    print_to_stdout do
    abort_on_panic do
    x = Vec.of [MyType 1 () true true, MyType 2 () false false]
    iter (ref x) print_mytype


    println (size_of (MkType: Type Unit))
    println (size_of (MkType: Type MyType))

impl drop_mytype: Drop MyType pure with
    drop _ = ()

// args: --delete-binary --no-color
// expected stdout:
// 1, true
// 2, false
// 1
// 4
