import Std.Sync.Thread.spawn
import Std.Sync.Arc.module, type, impl

// Clone an Arc into a spawned thread. When the thread's clone is dropped the shared
// value survives, so main's clone still reads it correctly after join.
reader (a: Arc I32): I32 =
    as_ref a

main () =
    print_to_stdout do
    original = Arc.of 99
    c = clone original
    t = spawn (do reader c)
    from_thread = join t
    from_main = reader original
    println from_thread
    println from_main

// args: --delete-binary --no-color
// expected stdout:
// 99
// 99

