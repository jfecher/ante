import Std.Sync.Thread.spawn
import Std.Sync.Mutex
import Std.Sync.Mutex.Mutex, drop_mutex
import Std.Sync.Arc
import Std.Sync.Arc.Arc, clone_arc, drop_arc

// Two threads each increment a value guarded by a Mutex 1000 times.
// with_lock provides mutual exclusion, so the final value is exactly 2000.
worker (m: Arc (Mutex U32)): Unit =
    for _i in 0..1000 do
        with_lock (as_ref m) fn v ->
            v += 1

main () =
    print_to_stdout do
    m = Arc.of (Mutex.of 0)
    c1 = clone m
    c2 = clone m
    t1 = spawn (do worker c1)
    t2 = spawn (do worker c2)
    join t1
    join t2
    println (with_lock (as_ref m) deref)

// args: --delete-binary --no-color
// expected stdout: 2000

