
type Struct1 = a:I32, b:F64, c:String

type Struct2 t =
    a: Thingy
    b: Generic t Thingy

type Union1 a b = | Variant1 | Variant2

type Maybe a =
   | Some a
   | None

type List a = | Nil | Cons a (ref List a)

type Shape = | Circle (radius: U32) | Square (length: U32) | Rect (width: U32) (height: U32) String

type UniquePtr a = ref a

t = 3 : I32

