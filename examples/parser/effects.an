
effect Log = log: fn String -> Unit

effect Use a =
    get: fn Unit -> a
    set: fn a I32 -> Unit

main () =
    handle log "test1"
    | log s -> print s

    handle
        log "test2"
    | log _   -> print "logged"

    handle foo + bar
    | get () -> foo resume 1 // test 'resume' is parsed as a normal identifier
    | set _ b -> resume ()

    handle ()
      | log _ -> "foo"

map1 (l: List a) (f: fn a {Log} -> b) : List b = ()

map2 (l: List a) (f: fn a -> b) : List b = ()

map3 (l: List a) (f: fn a -> b) {Log} : List b = ()

