import Foo.Bar

// Programs now require a main function
main () =
    var a = 32
    println (ref a)

type Foo =
    x: I32
    y: U32

print_foo (self: Foo) =
    print "Foo "
    // Comments are only allowed between statements
    print self.x
    print " "
    print self.y

// args: -e ast --no-color
