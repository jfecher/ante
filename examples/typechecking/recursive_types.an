import Std.Rc.Rc
import Std.Vec.Vec

type Box t = x: t
type Pair a b = first: a, second: b
type Id t = t

// Each of these store themselves without a pointer indirection
type Direct = x: Direct
type List = | Nil | Cons I32 List
type InTuple = x: (I32, InTuple)
type InArray = x: Array 2 InArray
type ThroughBox = | Leaf | Node (Box ThroughBox)
type ThroughPairs = x: Pair I32 (Pair Char ThroughPairs)
type ThroughAlias = x: Id ThroughAlias
type PolymorphicRecursion t = | PNil | PCons t (PolymorphicRecursion (t, t))

type MutualA = x: MutualB, y: I32
type MutualB = a: MutualA

type GenericA t = x: GenericB t
type GenericB t = y: GenericA t

type Variant = | Self (Variant.Self) | Other Char

// Not recursive itself, but contains MutualA which is
type ContainsMutual = x: MutualA

// Each of these are fine since they store themselves behind a pointer
type InRc = | C1 Char | C2 (Rc InRc)
type InPtr = | PNil | PCons I32 (Ptr InPtr)
shared type Shared = | SNil | SCons I32 Shared
type InVec t = | Leaf | Node (Vec (InVec t))
type RcList t = | RNil | RCons t (Rc (RcList t))
type InFunction = f: fn InFunction -> InFunction
type BoxedRc = x: Box (Rc BoxedRc)
type SecondBoxed = x: Pair I32 (Rc SecondBoxed)
type OtherVariant = | Other (OtherVariant.Leaf) | Leaf Char

type PointerA = x: Rc PointerB
type PointerB = a: PointerA

type Phantom t = x: Ptr t
type ThroughPhantom = x: Phantom ThroughPhantom

