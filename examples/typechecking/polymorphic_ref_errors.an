// 7 |     r.* := 1	// error: Cannot assign to r, declare it with var to make it mutable
//   |     ^
// 
// examples/typechecking/polymorphic_ref_errors.an:10:38
//  9 | // Nor can it be made mutable
//    | // error: The body of this function has type ref 'p I32 but it is expected to return mut 'p I32
// 10 | to_mut (r: ref 'p I32): mut 'p I32 = r
//    |                                      ^
// 
// examples/typechecking/polymorphic_ref_errors.an:17:6
// 16 |     v = Vec.of [1, 2]
//    |     // error: Cannot assign through a value of type ref 'v! _, a mut reference is required
// 17 |     v.get 0 := 5
//    |      ^^^^^^
