import Std.Vec.Vec, of, get
import Std.Stream.stream_array
import Std.Fail.Fail

// A polymorphic reference may be read-only so it can't be mutated
set_poly (r: ref 'p I32): Unit =
    r.* := 1

// Nor can it be made mutable
to_mut (r: ref 'p I32): mut 'p I32 = r

use_mut (_: mut I32): Unit = ()

// Anything reached through a reference to a non-var is read-only
set_first (): Unit can Fail, Panic =
    v = Vec.of [1, 2]
    v.get 0 := 5

main () =
    x = 1
    var y = 2

    // `x` is not a var so references to it are read-only
    rx = ref x
    rx.* := 3

    // A union is only mutable if each of its places is
    either = if true then ref x else ref y
    either.* := 4

    // `read` is never mutable
    use_mut (read y)

// args: --check --no-color
// expected exit status: 1
// expected stderr:
// examples/typechecking/polymorphic_ref_errors.an:7:5
