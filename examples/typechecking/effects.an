effect Log =
    log: fn String -> Unit

effect Use a =
    get: fn Unit -> a
    set: fn a -> Unit

// `log` is handled here, `set` escapes
handle_basic (): Unit can Use String =
    handle log "test1"
    | log v -> set v

use_resume () =
    handle ()
    | get () -> resume 3i32
    | set _ -> resume ()

does_use (x: I32): Unit can Use I32 =
    y: I32 = get ()
    set (y + x)

// Ensure a function with unhandled effects errors
pure_fn (): Unit is pure =
    log "foo"

// main must always handle all non-primitive effects
main () =
    log "foo"

