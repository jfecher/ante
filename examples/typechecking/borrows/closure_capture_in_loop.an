import Std.Collections.Vec

bad () =
    var v = Vec.empty ()
    var n = 0
    while n < 3 do
        var y = n
        push v (fn () -> y)
        n += 1

    var v = Vec.empty ()
    for i in 0 .. 3 do
        // What the body doesn't move is captured by reference unless the closure is a `move fn`
        push v (fn () -> i)

main () = ()

// args: --check --no-color
// expected exit status: 1
// expected stderr:
// examples/typechecking/borrows/closure_capture_in_loop.an:8:17
//  6 |     while n < 3 do
//  7 |         var y = n	// note: y is only valid until the end of this scope
//    |             -
//  8 |         push v (fn () -> y)	// error: This reference to y outlives its scope
//    |                 ^^^^^^^^^^
//  9 |         n += 1
// 
// examples/typechecking/borrows/closure_capture_in_loop.an:14:17
// 11 |     var v = Vec.empty ()
// 12 |     for i in 0 .. 3 do	// note: i is only valid until the end of this scope
//    |         -
// 13 |         // What the body doesn't move is captured by reference unless the closure is a `move fn`
// 14 |         push v (fn () -> i)	// error: This reference to i outlives its scope
//    |                 ^^^^^^^^^^
// 
// Found 2 errors and 0 warnings

