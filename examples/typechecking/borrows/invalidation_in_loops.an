import Std.Collections.Vec

// A loop body or closure may run again, so it may not use a binding it invalidates
import Std.Collections.Vec.get, clear, push
import Std.Iterator.repeat

use (_x: ref t): Unit = ()

bad1 () =
    var v = Vec.of [1, 2, 3]
    one = get v 0
    for _i in 0 .. 3 do
        use one
        clear v

bad2 () =
    var v = Vec.of [1, 2, 3]
    one = get v 0
    repeat 3 fn _ ->
        use one
        clear v

bad3 () =
    var v = Vec.of [1, 2, 3]
    one = get v 0
    for _i in 0 .. 3 do
        push v 4
    use one

ok1 () =
    var v = Vec.of [1, 2, 3]
    for _i in 0 .. 3 do
        one = get v 0
        use one
        push v 4

bad4 () =
    var v = Vec.of [1, 2, 3]
    one = get v 0
    while true do
        clear v
        use one

ok2 () =
    var v = Vec.of [1, 2, 3]
    var one = get v 0
    for _i in 0 .. 3 do
        use one
        push v 4
        one := get v 0

bad5 () =
    var v = Vec.of [1, 2, 3]
    var one = get v 0
    for _i in 0 .. 3 do
        use one
        one := get v 0
        push v 4

// args: --check --no-color
// expected exit status: 1
// expected stderr:
