type Resource = id: I32

consume _ = ()

ref_used_after_move () =
    r = Resource 1
    x = ref r
    consume r
    _ = x

ref_field_sibling_moved () =
    p = Resource 2, Resource 3
    x = ref p.first
    consume p.second
    _ = x  // ok

ref_field_moved () =
    p = Resource 4, Resource 5
    x = ref p.first
    consume p.first
    _ = x  // error here

ref_field_parent_moved () =
    p = Resource 6, Resource 7
    x = ref p.first
    consume p
    _ = x  // error, p is moved

ref_child_moved () =
    p = Resource 8, Resource 9
    x = ref p
    consume p.second
    _ = x  // error, p.second was moved

moved_in_branch (cond: Bool) =
    r = Resource 10
    x = ref r
    if cond then consume r
    _ = x

reassigned_after_move () =
    var r = Resource 11
    x = ref r
    consume r
    r := Resource 12
    // Ok. r is valid again and `ref` is not an exclusive reference kind
    _ = x

member_access_through_ref () =
    p = Resource 13, Resource 14
    x = ref p
    consume p
    _ = x.first  // error

nested_ref_use () =
    r = Resource 15
    t = ref r, 1
    consume r
    _ = t  // error, r is moved and this references r

ref_used_before_move () =
    r = Resource 16
    x = ref r
    _ = x  // ok
    consume r

main () = ()

