import Std.Vec.Vec

type Person =
    name: String
    age: I32

autoref () =
    var vec = Vec.empty ()
    hello = "Hello"
    vec.push (ref hello)

    if true then
        world = "World"
        vec.push world

annotated () =
    var v = Vec.empty ()
    v.push (ref 1)
    if true then
        y = 10
        // We weren't seeing through type annotation exprs previously so the
        // previous location reported for this error was worse
        v.push (ref (y: I32))

member_path () =
    var v = Vec.empty ()
    seed = "seed"
    v.push (ref seed)
    if true then
        p = Person "ann" 3
        v.push (ref p.name)

innocent_borrow_not_blamed () =
    var v = Vec.empty ()
    v.push (ref 1)
    if true then
        y = 10
        _ = ref y
        yref = ref y
        _ = ref y
        v.push yref
        _ = ref y
        _ = ref y

main () = ()

impl drop_person: Drop Person pure with
    drop _ = ()

