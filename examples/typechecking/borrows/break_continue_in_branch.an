import Std.Collections.Vec.module, type, get_unchecked, push

consume (_: Vec I32): Unit = ()
use (_: mut I32): Unit = ()
cond (): Bool = true

mutate_then_break (): Unit can Panic =
    var v = Vec.of [1, 2]
    elem = get_unchecked v 0
    while cond () do
        if cond () then
            // The borrow checker used to not count invalidations before a break/return
            push v 3
            break
    use elem

mutate_then_continue (): Unit can Panic =
    var v = Vec.of [1, 2]
    elem = get_unchecked v 0
    while cond () do
        use elem
        if cond () then
            push v 3
            continue

move_then_continue (): Unit can Panic =
    v = Vec.of [1, 2]
    while cond () do
        if cond () then
            consume v
            continue

move_then_break (): Unit can Panic =
    v = Vec.of [1, 2]
    while cond () do
        if cond () then
            consume v
            break

inner_loop_break (): Unit can Panic =
    var v = Vec.of [1, 2]
    elem = get_unchecked v 0
    for _i in 0 .. 3 do
        while cond () do
            if cond () then
                push v 3
                break
        use elem

break_before_return (): Unit can Panic =
    var v = Vec.of [1, 2]
    elem = get_unchecked v 0
    while cond () do
        if cond () then
            push v 3
            if cond () then break
            return ()
    use elem

mutate_then_return (): Unit can Panic =
    var v = Vec.of [1, 2]
    elem = get_unchecked v 0
    while cond () do
        use elem
        if cond () then
            push v 3
            return ()

move_then_return (): Unit can Panic =
    v = Vec.of [1, 2]
    while cond () do
        if cond () then
            consume v
            return ()
    consume v

main () = ()

