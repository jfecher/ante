four (): I32 = 42

// When `ref` is used in a return position without a parameter's place to use,
// it is assumed to be `ref 'a I32` for some concrete 'a. With no matching 'a
// it is similar to 'static in Rust.
bad_param (x: I32): ref I32 = ref x

// This used to issue duplicate errors
bad_param_block (x: I32): ref I32 =
    ref x

bad_early_return (x: I32) (b: Bool) (other: ref I32): ref I32 =
    // We should catch the auto-ref return here
    if b then return x
    other

main () =
    _f = fn x -> ref x
    _g = do ref four ()

// args: --check --no-color
// expected exit status: 1
