import Std.Vec.Vec

reads (v: mut 'v (Vec (ref 'e I32))) (_: ref 'k I32) = ()

writes (v: mut 'v (Vec (ref 'e I32))) (elem: ref 'e I32) =
    v.push elem

ok () =
    var nums = Vec.empty ()
    nums.push (ref 1)
    if true then
        reads (mut nums) 5

bad () =
    var nums = Vec.empty ()
    nums.push (ref 1)
    if true then
        writes (mut nums) 5

main () = ()

