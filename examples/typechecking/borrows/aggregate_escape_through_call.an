type Holder 'a = value: ref 'a I32

store (dst: mut 'd (Holder 'a)) (src: Holder 'a): Unit =
    dst := src

bad_constructor () =
    var out = Holder (ref 0)
    if true then
        y = 10
        h = Holder (ref y)
        store (mut out) h

main () = ()

