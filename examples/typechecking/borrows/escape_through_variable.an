bad_return (): ref I32 =
    x = 5
    r = ref x
    r

bad_early_return (b: Bool) (other: ref I32): ref I32 =
    if b then
        x = 1
        r = ref x
        return r
    other

bad_match (b: Bool) (other: ref I32): ref I32 =
    match b
    | true ->
        r = ref 1
        r
    | false -> other

bad_tuple_field (): ref I32 =
    x = 5
    pair = ref x, 1
    pair.first

main () = ()

