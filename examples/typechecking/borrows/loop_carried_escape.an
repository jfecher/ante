bad_while (cond: Bool): Maybe (ref I32) =
    var r = Maybe.None
    x = 1
    while cond do
        if cond then return r
        r := Some (ref x)
    None

bad_for (cond: Bool): Maybe (ref I32) =
    var s = Maybe.None
    x = 1
    for _i in 0 .. 3 do
        r = s
        if cond then return r
        s := Some (ref x)
    None

main () = ()

