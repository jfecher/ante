// A place a function mutates may not alias any of its other places
import Std.Vec.Vec, of, get, clear
import Std.Stream.stream_array
import Std.Fail.Fail

use (_x: ref t): Unit = ()

twice (f: fn a a => Unit can e) (x: a) {Copy a}: Unit can e =
    f x x

mutate_b (a: mut 'a Vec I32) (b: mut 'b Vec I32): Unit can Mutate 'b =
    use a
    b.clear ()

bad1 () =
    var v = Vec.of [1, 2, 3]
    twice mutate_b (mut v)

run (f: Unit can e) (xs: ref Vec I32): Unit can e, Fail =
    first = xs.get 0
    f ()
    use first

bad2 () =
    var v = Vec.of [1, 2, 3]
    run (fn () -> v.clear ()) (ref v)

ok2 () =
    var v = Vec.of [1, 2, 3]
    other = Vec.of [4]
    run (fn () -> v.clear ()) (ref other)

bad3 () =
    var v = Vec.of [1, 2, 3]
    clear_v = fn () -> v.clear ()
    run clear_v (ref v)

two_args (a: ref 'a Vec I32) (b: mut 'b Vec I32): Unit can Mutate 'b, Fail =
    a_elem = a.get 0
    b.clear ()
    use a_elem

two_args2 (a: mut _) b =
    two_args a b

bad4 (v: mut Vec I32) =
    two_args v v

bad5 (p: mut (Vec I32, Vec I32)) =
    two_args p.first p.first

bad6 v =
    two_args2 v v

ok3 (p: mut (Vec I32, Vec I32)) =
    two_args p.first p.second

ok4 () =
    var pair = Vec.of [1], Vec.of [2]
    two_args pair.first (mut pair.second)

