import Std.Vec.Vec, of, get, get_mut, clear, push
import Std.Stream.stream_array
import Std.Fail.Fail

use (_x: ref t): Unit = ()

// Example from website
bad (a: mut Vec I32) (b: mut Maybe String) (c: mut (String, String)) =
    elem = a.get 1
    a.clear ()
    use elem

    s = if b is Some s then s else panic ""
    b := None
    use s

    // Fields are stable
    name = ref c.first
    c.first := "Foo"
    use name

example2 (v: mut Vec String) =
    a: ref 'v! String = v.get 0
    b: mut 'v! String = v.get_mut 0
    use a

    // Mutating 'v! only invalidates 'v!!
    b := "foo"
    use b

    v.clear ()
    use b

write_through (b: mut Maybe String) =
    s = if b is Some s then s else panic ""
    b := None
    s := "dangling"

field_through (b: mut Maybe (I32, I32)) =
    p = if b is Some p then p else panic ""
    b := None
    use p.first

branch (b: mut Maybe String) (c: Bool) =
    s = if b is Some s then s else panic ""
    if c then b := None
    use s

reassigned (b: mut Maybe String) =
    var s = if b is Some s then s else panic ""
    b := None
    s := (if b is Some s2 then s2 else panic "")
    use s

local () =
    var v = Vec.of [1, 2, 3]
    first = v.get 0
    v.push 4
    use first

// Calling a closure performs its effects, like `Mutate 'v` here
closure () =
    var v = Vec.of [1, 2, 3]
    clear_v = fn () -> v.clear ()
    first = v.get 0
    clear_v ()
    use first

closure_unused () =
    var v = Vec.of [1, 2, 3]
    first = v.get 0
    clear_v = fn () -> v.clear ()
    use first
    clear_v ()

apply (f: fn Unit => Unit can e): Unit can e = f ()

inferred_effect_variable (v: mut Vec I32) =
    a = v.get 0
    apply do use a
    use a
    v.clear ()

declared_effect_variable (v: mut Vec I32): Unit can Mutate 'v, Fail =
    a = v.get 0
    apply do use a
    use a
    v.clear ()

mutate_through_effect_variable (v: mut Vec I32): Unit can Mutate 'v, Fail =
    a = v.get 0
    apply do v.clear ()
    use a

missing_mutate (v: mut 'v Vec I32): Unit can Panic =
    v.push 1

declared_mutate (v: mut 'v Vec I32): Unit can Mutate 'v, Panic =
    v.push 1

// An elided place is named after its parameter
elided_missing_mutate (v: mut Vec I32): Unit can Panic =
    v.push 1

elided_declared_mutate (v: mut Vec I32): Unit can Mutate 'v, Panic =
    v.push 1

clear_inferred (v: mut Vec I32) = v.clear ()

through_inferred () =
    var v = Vec.of [1, 2, 3]
    first = v.get 0
    clear_inferred (mut v)
    use first

// Mutating while computing a binding's value doesn't invalidate it
mutated_in_initializer (v: mut Vec I32) =
    first =
        v.push 1
        v.get 0
    use first

// Only the parts of a value holding an unstable reference are invalidated
unrelated_field (v: mut Vec I32) =
    pair = v.get 0, 5
    v.clear ()
    use pair.second
    use pair.first

reassigned_in_both_branches (v: mut Vec I32) (c: Bool) =
    var first = v.get 0
    v.clear ()
    if c then
        first := v.get 0
    else
        first := v.get 1
    use first

reassigned_then_mutated_in_one_branch (v: mut Vec I32) (c: Bool) =
    var first = v.get 0
    if c then
        first := v.get 0
        v.clear ()
    else
        first := v.get 1
    use first

