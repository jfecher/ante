type MyVec t =
    data: Ptr t
    len: Usz

get (v: ref 'v MyVec t) (i: Usz): ref 'v! t =
    transmute (offset v.data i)

get_nested (v: ref 'v MyVec (MyVec t)) (i: Usz): ref 'v!! t =
    inner = get v i
    get inner 0

forward (v: ref 'v MyVec t): ref 'v! t = get v 0

inferred (v: ref MyVec t) = get v 0

either (x: ref 'a I32) (y: ref 'b I32): ref '(a, b) I32 =
    if true then x else y

mixed (_x: ref '(a, b!) I32) (y: ref 'b! I32): ref '(a, b!) I32 = y

elided (x: ref 'a! I32): ref I32 = x

annotated (vec: ref 'v MyVec t): Unit =
    _a: ref 'v! t = get vec 0
    ()

use_elem (_r: ref 'v! I32) (_v: ref 'v MyVec I32): Unit = ()

type Pair =
    first: I32
    second: I32

first (p: ref 'p Pair): ref 'p.first I32 = transmute p

type Rc 'p t = ptr: Ptr t

rc_get (rc: ref 'outer Rc 'inner t): ref '(outer!, inner) t = transmute rc.ptr

type L 'q t = value: ref 'q t

holder (l: L 'q! t): ref 'q! t = l.value

main () =
    xs = MyVec (transmute 0) 0
    ys = MyVec (transmute 0) 0
    _e = get (ref xs) 0
    _f = forward (ref xs)
    _i = inferred (ref xs)
    use_elem (get (ref xs) 0) (ref xs)
    _j = if true then get (ref xs) 0 else get (ref ys) 0
    _k = elided (get (ref xs) 0)
    pair = Pair 1 2
    _p = first (ref pair)
    rc = Rc (transmute 0)
    _g = rc_get (ref rc)
    _h = holder (L (get (ref xs) 0))

