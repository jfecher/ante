//     (transmute: fn (Ptr t) -> ref 'v! t is pure) ((offset: fn (Ptr t) Usz -> Ptr t is pure) ((copy_ptr: Copy (Ptr t) copy_ptr)..* (v: ref 'v (MyVec t)).data) (i: Usz))
// 
