type Pair a b = first: a, second: b

use_hole () =
    p: Pair _ _ = Pair 1 2
    p.first

f (g: fn _ -> _) = g 1

type Box t = value: t

// A `_` written in a parameter is inferred from the body like any other type variable
pick (x: Box _) (y: Box t): Box t = if true then x else y
mismatched_boxes () = pick (Box 3i32) (Box (5i64, 6i64))

// A `=>` parameter's environment is rigid, so the body can't narrow it
narrow (f: fn I32 => I32 is pure): fn I32 -> I32 = f

// An environment written as `[_]` is inferred instead
infer_env (f: fn I32 [_] -> I32 is pure): fn I32 -> I32 = f

