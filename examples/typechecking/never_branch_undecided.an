// A diverging branch shouldn't decide the type of the other branches,
// even when the result has no expected type yet
stop (): Never = stop ()

use_i32 (_x: I32): Unit = ()
use_str (_x: String): Unit = ()

if_last (b: Bool): Unit =
    x = if b then "a" else stop ()
    use_str x

match_middle (n: I32): Unit =
    x = match n
        | 0 -> stop ()
        | 1 -> "one"
        | 2 -> stop ()
        | _ -> "many"
    use_str x

in_loop (n: I32): Unit =
    for i in 0 .. n do
        x = if i > 2 then break else i
        use_i32 x

mismatch (b: Bool): Unit =
    x = if b then stop () else 3
    use_str x

main () = ()

