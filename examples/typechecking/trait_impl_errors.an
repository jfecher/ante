trait Show t =
    show: fn t -> String
    name: String

// An impl's data is not a member of its trait
impl show_i32: Show I32 with
    show x = cast x
    name = "i32"
    impl_data = 3

// Trait dictionaries can only be created by an impl
implicit show_u8: Show U8 = Show with
    show x = cast x
    name = "u8"

implicit show_bool: Show Bool = Show (fn b -> if b then "yes" else "no") "bool"

// Only the construction is reported, even when nested, not the implicit's omitted impl argument
implicit show_char: Show Char =
    name = "char"
    Show with
        show _ = "char"
        name = name

// An impl's data holds its parameters and is copied along with its values, so they must be Copy
impl show_with (suffix: String): Show I64 with
    show x = cast x ++ suffix
    name = "i64"

impl show_copy {Copy t} (value: t) {Show t}: Show (t, t) with
    show _ = show value
    name = "pair"

// The trait's hidden impl generic can't be referred to
trait Pick a =
    pick: fn a i -> i

// A trait method's environment is its impl's data, so it can't declare another
trait Gen t =
    gen: fn t [I32] -> I32

// The same goes for a method whose environment is given by a type alias
type Counter t = fn t [I32] -> I32

trait Count t =
    count: Counter t

