type Expr =
    | Var (name: String)
    | Lit I64
    with location: I32

// Ensure non-common fields still error
bad_field (e: Expr): String = e.name
ok_field (e: Expr): I32 = e.location

type Dup1 =
    | A I32
    | B I32
    with location: I32, location: I32

type Dup2 =
    | A (location: I32)
    | B I32
    with location: I32

main () = ()

