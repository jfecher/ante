// TODO: This should compile. `tree_sum l` needs `'t` to contain `'t!`, so recursive calls must instantiate places.
shared type Tree =
    | Leaf I32
    | Node Tree Tree

tree_sum (t: ref Tree): I32 =
    match t
    | Leaf x -> x.*
    | Node l r -> tree_sum l + tree_sum r

