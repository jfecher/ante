//    |     // error: Type annotation fn Unit -> I32 can Emit I32 does not match the inferred type fn Unit -> I32 is pure
//  8 |     x: fn Unit -> I32 can Emit I32 = four
//    |                                      ^^^^
//  9 |     handle println (x ())
