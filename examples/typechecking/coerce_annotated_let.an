import Std.Stream.Emit, emit

four (): I32 = 4

// A free function has no environment, so any effects must match exactly
main () =
    print_to_stdout do
    x: fn Unit -> I32 can Emit I32 = four
    handle println (x ())
    | emit z ->
        println z
        resume ()

// args: --check --no-color
