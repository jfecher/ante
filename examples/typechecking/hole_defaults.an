type Tagged a (tag = _) =
    value: a

// Omitting an argument defaulting to `_` within an effect is an error, as in a type definition
effect Logger =
    log_value: fn I32 {Display I32 pure} -> Unit

// Explicitly giving it is fine
effect Logger2 i =
    log_value2: fn I32 {Display I32 pure i} -> Unit

too_few (_: Tagged): Unit = ()

// Omitted `_` arguments in a declared signature are independent rigid generics so these may
// have different tags, and the body can't make them the same. Naming the tag does.
mismatched (x: Tagged I32) (y: Tagged I32 t): Tagged I32 t = if true then x else y
matched (x: Tagged I32 t) (y: Tagged I32 t): Tagged I32 t = if true then x else y

// An omitted `_` argument in a return type is inferred from the body instead
inferred (x: Tagged I32 U8): Tagged I32 = x
use_inferred (): Tagged I32 U8 = inferred (Tagged 3)

// Omitted arguments are left out of errors as they are in the source
retag (x: Tagged I32): Tagged I32 U8 = x

// Unless they are all that differs
mix (x: Tagged I32) (y: Tagged I32): Unit = ignore (if true then x else y)

// Elsewhere an omitted `_` argument is a fresh type variable
local (): Tagged I32 U8 =
    x: Tagged I32 = Tagged 3
    x

trait Show t =
    show: fn t -> String

impl show_i32: Show I32 with
    show _ = "i32"

impl show_i32_alt: Show I32 with
    show _ = "alt"

// An impl's name in a type position refers to its data type
use_alt (x: I32) {s: Show I32 show_i32_alt}: String = Show.show x {s}
call_alt (): String = use_alt 3

// A known impl argument is shown when no implicit is found, since it is why none matched
wrong_impl (): String = use_bool true
use_bool (x: Bool) {s: Show Bool show_i32_alt}: String = Show.show x {s}

// The data type of an impl without parameters takes no arguments
bad_impl_type {_: Show I32 (show_i32 I32)}: Unit = ()

