import Std.HashMap.HashMap
import Std.Fail.or_panic

main () =
    abort_on_panic do
    map: HashMap U8 I32 = HashMap.empty ()
    // Error here should suggest importing `hash_u8`
    elem = map.get (ref 4) ~> or_panic "map get failed"
    println elem

// Found 1 error and 0 warnings

