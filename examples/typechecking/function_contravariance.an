needs_read_fn (_f: fn (read I32) -> Unit): Unit = ()

needs_mut_fn (_f: fn (mut I32) -> Unit): Unit = ()

use_read (_x: read I32): Unit = ()

use_mut (_x: mut I32): Unit = ()

main () =
    use_read (mut 3)
    use_mut (ref 3)
    needs_mut_fn use_read
    needs_read_fn use_mut

