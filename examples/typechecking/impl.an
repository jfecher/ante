
trait Foo a =
    foo: fn a a -> a

impl foo_i32: Foo I32 with
    foo _a b = b

impl foo_f64: Foo F64 with
    foo _a b = b


a = foo 1 2i32
b = foo 1.0 2.0
c = foo "one" "two"

// args: -e ast-t --no-color
// expected exit status: 1
// expected stdout:
// type Foo a ($impl = _) =
//     foo: fn a a -> a
// 
// implicit (foo_i32: Foo I32 foo_i32) = Foo I32 with
//     (foo: fn I32 I32 -> I32 is pure) = fn (_a: I32) (b: I32) -> (b: I32)
// 
// implicit (foo_f64: Foo F64 foo_f64) = Foo F64 with
//     (foo: fn F64 F64 -> F64 is pure) = fn (_a: F64) (b: F64) -> (b: F64)
// 
// (a: I32) = (foo_i32: Foo I32 foo_i32).foo 1 2_I32
// 
// (b: F64) = (foo_f64: Foo F64 foo_f64).foo 1.0 2.0
// 
// (c: String) = (error).foo "one" "two"

