import Std.Vec

// A temporary is dropped at the end of its statement, so nothing may keep a reference to it
make (): String = "temporary" ++ "!"

longest (a: ref 'a String) (b: ref 'a String): ref 'a String =
    if a.length > b.length then a else b

held () =
    kept = "kept"
    dangling = longest (ref kept) (ref make ())
    println dangling

pushed () =
    var strings = Vec.empty ()
    push strings (ref make ())

// A temporary borrowed by the definition itself lives as long as the definition's name
extended () =
    borrowed = ref make ()
    println borrowed

main () = ()

// args: --check --no-color
// expected exit status: 1
// expected stderr:
// examples/typechecking/drops/temporaries.an:11:40
// 10 |     kept = "kept"
//    |     // error: This reference to a temporary value outlives its scope
//    |     // note: this value is only valid until the end of this scope
// 11 |     dangling = longest (ref kept) (ref make ())
//    |                                        ^^^^^^^
// 12 |     println dangling
// 
// examples/typechecking/drops/temporaries.an:16:23
// 15 |     var strings = Vec.empty ()
//    |     // error: This reference to a temporary value outlives its scope
//    |     // note: this value is only valid until the end of this scope
// 16 |     push strings (ref make ())
