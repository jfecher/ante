// A closure borrows the values it captures unless they are `Copy` or it is a `move` closure.
// A borrowed value has the same type within the closure but cannot be moved out of it.
make (): String = "captured" ++ "!"

consume (_s: String): Unit = ()

escapes () =
    s = make ()
    fn () -> println s

moves_out () =
    s = make ()
    _f = fn () -> consume s

moves_out_of_move_closure () =
    s = make ()
    _f = move fn () -> consume s

// These are fine
borrows () =
    s = make ()
    f = fn () -> println s
    f ()
    f ()

owns () =
    s = make ()
    move fn () -> println s

clones () =
    s = make ()
    move fn () -> consume (clone s)

main () = ()

// args: --check --no-color
// expected exit status: 1
// expected stderr:
// examples/typechecking/drops/closures.an:9:5
//  7 | escapes () =
//  8 |     s = make ()	// note: s is only valid until the end of this scope
//    |     -
//  9 |     fn () -> println s	// error: This reference to s outlives its scope
//    |     ^^^^^^^^^^^^^^^^^^
// 
// examples/typechecking/drops/closures.an:13:27
// 12 |     s = make ()
//    |     // error: Cannot move s because this closure captures it by reference. Use a move fn to capture it by value
// 13 |     _f = fn () -> consume s
//    |                           ^
// 
// Found 2 errors and 0 warnings

