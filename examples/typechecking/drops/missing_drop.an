import Std.Mem.forget

// A value must be moved, dropped, or forgotten before it goes out of scope
type Resource = id: I32

concrete () =
    _resource = Resource 1

generic (_value: t): Unit = ()

unused_result (make: fn Unit -> Resource): Unit =
    make ()
    ()

overwritten (): Unit =
    var resource = Resource 1
    resource := Resource 2
    forget resource

// These are all fine
constrained (_value: t) {Drop t e}: Unit can e = ()

moved (value: t): t = value

forgotten (value: t): Unit = forget value

copied (_value: t) {Copy t}: Unit = ()

main () = ()

// args: --check --no-color
