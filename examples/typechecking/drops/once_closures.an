// Only a `once fn` may move what it captures, and calling one moves it
make (): String = "captured" ++ "!"

consume (_s: String): Unit = ()

called_twice () =
    s = make ()
    f = move fn () -> consume s
    f ()
    f ()

used_as_fn () =
    s = make ()
    f: fn Unit => Unit = move fn () -> consume s
    f ()

never_dropped (f: fn Unit => Unit): Unit = f ()

once_twice (f: once fn Unit => Unit): Unit =
    f ()
    f ()

// Calling a `once fn` moves it, so it must be held by something it can be moved out of
type Holder env = action: once fn Unit [env] -> Unit

through_reference (holder: ref (Holder env)): Unit =
    holder.action ()

make_action () =
    s = make ()
    move fn () -> consume s

global_action = make_action ()

from_global () = global_action ()

// These are fine
owned_field (holder: Holder env): Unit =
    holder.action ()

run_once (f: once fn Unit => Unit): Unit = f ()

twice (f: fn Unit [env] -> Unit) {Drop env pure}: Unit =
    f ()
    f ()

reads () =
    s = make ()
    f = move fn () -> println s
    f ()
    f ()
    run_once f

main () = ()

