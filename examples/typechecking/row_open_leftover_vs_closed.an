// 11 | // An open row that still has an unmatched effect cannot unify with a closed row lacking it
//    | // error: This function call returns Maybe (fn Unit -> Unit can Fail, _) but Maybe (fn Unit -> Unit can Log) was expected
// 12 | foo c = use_it (mk c)
