effect Log =
    log: fn Unit -> Unit

effect Fail =
    fail: fn Unit -> Unit

mk (f: fn Unit -> Unit can Fail, e): Maybe (fn Unit -> Unit can Fail, e) = Some f

use_it (_m: Maybe (fn Unit -> Unit can Log)): Unit = ()

// An open row that still has an unmatched effect cannot unify with a closed row lacking it
foo c = use_it (mk c)

bar (_m: Maybe (fn Unit -> Unit can Fail, e)): Unit = ()

baz (m: Maybe (fn Unit -> Unit can Log)): Unit = bar m

// args: --check --no-color
