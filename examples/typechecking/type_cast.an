main () =
    _a = U32 42u8 // ok
    _b = I64 (I64 42) // ok

    // No Cast impl from U8 to I32
    _c = I32 42u8

    // No Cast impl from String to U8
    _d = U8 "hello"

    // No Cast impl from Bool to U8
    _e = U8 true

// args: -e ast-t --no-color
// expected exit status: 1
// expected stdout:
// (main: fn Unit -> Unit is pure) () =
//     (_a: U32) = (cast_u8_u32: Cast U8 U32 pure).cast 42_U8: U32
//     (_b: I64) = (cast_same: Cast I64 I64 pure).cast ((cast_i32_i64: Cast I32 I64 pure).cast 42: I64): I64
//     (_c: I32) = (cast_u8_i32: Cast U8 I32 pure).cast 42_U8: I32
//     (_d: U8) = (error).cast "hello": U8
//     (_e: U8) = (error).cast true: U8


// expected stderr:
// examples/typechecking/type_cast.an:9:10
//  8 |     // No Cast impl from String to U8
//    |     // error: No implicit found for type Cast String U8 pure required by cast
//  9 |     _d = U8 "hello"
//    |          ^^^^^^^^^^
// 
// examples/typechecking/type_cast.an:12:10
// 11 |     // No Cast impl from Bool to U8
// 12 |     _e = U8 true	// error: No implicit found for type Cast Bool U8 pure required by cast
//    |          ^^^^^^^
// 
// Found 2 errors and 0 warnings

