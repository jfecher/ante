type P 'a =
    x: ref 'a I32

// The inner place of a partial signature is inferred
deref_of_ref_inferred (a: mut (ref I32)) =
    a.* := 2

// But it is rigid in a full signature, so it can't be mutated through
deref_of_ref (a: mut (ref I32)): Unit can Mutate 'a =
    a.* := 2

field_through_mut (q: mut P 'a) =
    q.x.* := 5

field_of_var () =
    y = 1
    z = 2
    var p = P (ref y)
    p.x := 5
    p.x := ref z

main () = ()

// args: --check --no-color
// expected exit status: 1
// expected stderr:
// examples/typechecking/assign_through_immutable.an:10:6
//  9 | deref_of_ref (a: mut (ref I32)): Unit can Mutate 'a =
//    |     // error: Cannot assign through a value of type ref '_ I32, a mut reference is required
// 10 |     a.* := 2
//    |      ^^
// 
// examples/typechecking/assign_through_immutable.an:13:8
// 12 | field_through_mut (q: mut P 'a) =
//    |     // error: Cannot assign through a value of type ref 'a I32, a mut reference is required
// 13 |     q.x.* := 5
//    |        ^^
// 
// examples/typechecking/assign_through_immutable.an:19:12
// 18 |     var p = P (ref y)
// 19 |     p.x := 5	// error: Cannot assign a value of type I32 to a target of type ref 'y I32
//    |            ^
// 20 |     p.x := ref z
// 
// Found 3 errors and 0 warnings

