type Wrap t = inner: t

type Foo a (b = I32) = x: a, y: b

type Three a b (c = I32) = x: a, y: b, z: c

type Bar (t = _) = value: t

type Nested a (b = Wrap a) (c = b) = first: a, second: b, third: c

type Sized (n: U32 = 4) (t = I32) = storage: Array n t

foo_default (f: Foo String) = f.y
foo_explicit (f: Foo String String) = f.y
nested (n: Nested I32) = n.third
nested_partial (n: Nested I32 String) = n.third
sized (s: Sized) = s.storage

// A `_` default is a fresh type variable
bar_param (b: Bar) = b.value

// Constructors infer omitted type arguments rather than using their defaults
bar_constructed () = Bar with value = "hi"
foo_constructed () = Foo String with x = "hi", y = 3

three_too_few (t: Three I32) = t
too_many (f: Foo I32 I32 I32) = f

// A `_` default must be explicitly specified within a type definition
type UsesHole = b: Bar

type Recursive a (b = Recursive a) = x: a

type BadKind (n: U32 = I32) = x: Array n I32

