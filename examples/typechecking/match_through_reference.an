// Matching through a reference binds each field by reference. Fields in a union's payload are unstable.
type Shape =
    | Circle F64
    | Rect F64 F64
    with name: String

set_some (b: mut 'b Maybe String) =
    if b is Maybe.Some s then
        s := "changed"

pair_fields (p: ref 'p (I32, String)) =
    match p
    | (a, _) -> a

nested (m: ref 'm Maybe (I32, String)): ref 'm! String can Panic =
    match m
    | Some (_, y) -> y
    | None -> panic "none"

shape_fields (s: ref 's Shape) =
    match s
    | Circle radius _ -> radius
    | Rect _ _ name ->
        _name = name
        panic ""

whole_variant (m: ref 'm Maybe I32) =
    match m
    | Some ..c -> c
    | None -> panic ""

alias (m: ref 'm Maybe I32) =
    match m
    | whole @ Some x -> (whole, x)
    | None -> panic ""

literal (r: ref I32): Bool =
    match r
    | 0 -> true
    | _ -> false

parameter ((a, _): mut 'p (I32, I32)) = a

inferred (m: ref Maybe String) (default: ref String) =
    match m
    | Some s -> s
    | None -> default

main () =
    m = Maybe.Some "x"
    default = "y"
    _s = inferred (ref m) (ref default)

