// Regression for #215
effect Emit a =
    emit: fn a -> Unit

iota (n: U32): Unit can Emit U32 = loop (i = 0) ->
    if i < n then
        emit i
        recur (i + 1)

filter (stream: fn Unit => Unit can Emit a) (predicate: fn a => Bool) {Copy a} = fn () can Emit a ->
    handler h for emit x ->
        if predicate x then
            emit x
        resume ()
    in stream ()

for_ (stream: fn Unit => Unit can Emit a) (f: fn a => b) =
    handler h for emit x ->
        f x
        resume ()
    in stream ()

main () =
    stream = filter (do iota 10) (_ %% 2)
    for_ stream (println _ {print_u32})

