// Only irrefutable patterns are allowed on parameters & definitions
f (Maybe.Some x: Maybe I32): I32 = x

main () =
    // Without parentheses this is parsed as a function definition
    (Maybe.Some y) = Maybe.Some 3
    println (f (Maybe.Some y))

