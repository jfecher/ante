type Shape =
    | Circle F64
    | Rect F64 F64
    with name: String

// Payload references are unstable, so they can't be returned as a stable place
stable_lie (m: ref 'm Maybe String) (default: ref 'm String): ref 'm String =
    match m
    | Some s -> s
    | None -> default

// The variant's standalone layout puts its `with` fields last, so there is nothing to point to
rest_with_fields (s: ref Shape) =
    if s is Circle .._c then ()

consume (_s: String): Unit = ()

// `'s!` may point anywhere within `s`, including its moved `name`
moved_with_field (s: Shape) =
    r = ref s
    if r is Circle radius _ then
        consume s.name
        _radius = radius
        ()

