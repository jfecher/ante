effect Read = read: fn Unit -> String
effect Write = write: fn String -> Unit

effect FileIO = Read, Write
effect WithLog (e: effect) = Log, e
effect Log = log: fn String -> Unit

// FileIO allows read & write access
copy_file (): Unit can FileIO =
    read () |> write

copy_file_expanded (): Unit can Read, Write =
    read () |> write

// Ensure effect kinds work & are expanded properly in aliases
with_log (): Unit can WithLog Read =
    log "reading"
    read () |> ignore

// Effect aliases cannot be recursive
effect A = B
effect B = A

use_a (): Unit can A = ()

