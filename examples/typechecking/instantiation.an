
add m n = move fn (f: t) {Copy t} -> move fn x -> m f (n f x)  // (a -> b -> c) -> (a -> d -> b) -> a -> d -> c

one f x = f x  // (a -> b) -> a -> b
two1 (f: fn _ [env] -> _) x {Drop env e} = f (f x) // (a -> a) -> a -> a

two2 = add one one

// id is polymorphic, expect no error here
main () =
    id 3
    id "four"
    id ()

id x = x

