import Std.Mem.transmute, offset
type MyVec t =
    data: Ptr t
    len: Usz

get (v: ref 'v MyVec t) (i: Usz): ref 'v! t =
    transmute (offset v.data i)

stable_lie (v: ref 'v MyVec t): ref 'v t = get v 0

too_unstable (v: ref 'v MyVec t): ref 'v!! t = get v 0

wrong_root (v: ref 'v MyVec t) (_w: ref 'w I32): ref 'w! t = get v 0

kind_error (x: t) (_y: ref 't! I32): t = x

