// 
// (take_len: fn (ref '_ (Array n t)) -> Usz is pure) =
//     fn (arr: ref '_ (Array n t)) -> (array_len: fn (ref '_ (Array n t)) -> Usz is pure) (arr: ref '_ (Array n t))
// 
