type Shape = | Circle (radius: U32) | Square (length: U32)

radius (shape: Shape): U32 =
    match shape
    | Circle ..c -> c.radius

type Expr =
    | Var String
    | Lit I64
    with location: I32

loc (e: Expr): I32 =
    match e
    // Missing location field
    | Var _s -> 0

main () = ()

