trait Named t =
    name: fn t -> String

impl named_i32: Named I32 with
    name _ = "i32"

// An implicit's type must be known without checking its body, so its impl can't be inferred
implicit alias: Named I32 = named_i32

implicit forward {d: Named t}: Named t = d

// Naming the impl explicitly is fine
implicit alias2: Named I32 named_i32 = named_i32

implicit forward2 {d: Named t i}: Named t i = d

// Omitting it through a type alias is the same
type NamedI32 (i = _) = Named I32 i

implicit aliased: NamedI32 = named_i32

// An impl's own impl argument is always its own data type
impl named_bool: Named Bool named_i32 with
    name _ = "bool"

// args: --check --no-color
