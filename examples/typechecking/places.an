foo (): I32 = 5

type Pair =
    a: I32
    b: I32

main () =
    x = 3
    _y = ref x
    p = Pair 1 2
    _q = ref p.a
    a = 1
    b = 2
    _z = if true then ref a else ref b
    _w = ref (foo ())

// args: -e ast-t --no-color
// expected stdout:
// (foo: fn Unit -> I32 is pure) () : I32 is pure = 5
// 
// type Pair =
//     a: I32
//     b: I32
// 
// (main: fn Unit -> Unit is pure) () =
//     (x: I32) = 3
//     (_y: ref 'x I32) = ref (x: I32)
//     (p: Pair) = (Pair: fn I32 I32 -> Pair is pure) 1 2
//     (_q: ref 'p.a I32) = ref (p: Pair).a
//     (a: I32) = 1
//     (b: I32) = 2
//     (_z: ref '(a, b) I32) = if true then ref (a: I32) else ref (b: I32)
//     (_w: ref '_29 I32) = ref (foo: fn Unit -> I32 is pure) ()
