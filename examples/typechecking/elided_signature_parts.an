// (store: fn (mut 'v (Vec (ref '_ I32))) (ref 'x I32) -> Unit can Mutate 'v, Panic) (v: mut 'v (Vec (ref '_ I32))) (x: ref 'x I32): Unit can Mutate 'v, Panic =
//     (push: fn (mut 'v (Vec (ref '_ I32))) (ref '_ I32) -> Unit can Mutate 'v, Panic) (v: mut 'v (Vec (ref '_ I32))) (x: ref 'x I32)
// 
// (store_annotated: fn (mut 'p (Vec (ref '_ I32))) -> Unit can Mutate 'p, Panic) (v: mut 'p (Vec (ref '_ I32))) =
//     (x: I32) = 1
//     (push: fn (mut 'p (Vec (ref '_ I32))) (ref '_ I32) -> Unit can Mutate 'p, Panic) (v: mut 'p (Vec (ref '_ I32))) (ref (x: I32))
// 
// (nested_clause: fn (ref 'x I32) (fn Unit -> Unit can Emit (ref I32)) -> ref 'x I32 is pure) (x: ref 'x I32) (_f: fn Unit -> Unit can Emit (ref I32)): ref I32 = (x: ref 'x I32)
// 
// (apply: fn (fn I32 -> I32 can e) I32 -> I32 can e) (f: fn I32 -> I32 can e) (x: I32): I32 can e = (f: fn I32 -> I32 can e) (x: I32)
// 
// (twice: fn (fn I32 -> I32 can _) (fn I32 -> I32 can _) I32 -> I32 can _) (f: fn I32 -> I32 can _) (g: fn I32 -> I32 can _) (x: I32): I32 = (g: fn I32 -> I32 can _) ((f: fn I32 -> I32 can _) (x: I32))
