import Std.Vec.Vec
import Std.Stream.Emit

// An elided parameter place is named after its parameter
same (x: ref t): ref t = x

// Every other elided place in a parameter is a rigid place of its own, so `x` can't be stored in `v`
store (v: mut (Vec (ref I32))) (x: ref I32): Unit can Mutate 'v, Panic =
    v.push x

// An annotation's elided parameter places are rigid too, so a local can't be stored in `v`
store_annotated: fn (mut 'p (Vec (ref I32))) -> Unit can Mutate 'p, Panic = fn v ->
    x = 1
    v.push (ref x)

// A place in a parameter's `can` clause isn't an input place, so `x` is the only one
nested_clause (x: ref I32) (_f: fn Unit -> Unit can Emit (ref I32)): ref I32 = x

// Function parameters without a `can` clause reuse the clause's effect variable
apply (f: fn I32 -> I32) (x: I32): I32 can e = f x

// Otherwise they share a fresh one, which is added to the function's own clause
twice (f: fn I32 -> I32) (g: fn I32 -> I32) (x: I32): I32 = g (f x)

main () = ()

// args: -e ast-t --no-color
