
trait Bar a b =
    bar: fn a a -> b


impl bar1: Bar I32 String with
    bar _ _ = "good"

impl bar2: Bar I32 I32 with
    bar _ _ = 0

impl bar4: Bar I32 F64 with
    bar _ _ = 23.2 // Multiple matching impls when used at I32

foo a b = bar a b

baz (x: String) y = bar x y
_ = bar 3 2

_ = bar "four" "five"

// args: -e ast-t --no-color
// expected exit status: 1
// expected stdout:
// type Bar a b ($impl = _) =
