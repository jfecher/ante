// 
// implicit (bar1: Bar I32 String bar1) = Bar I32 String with
//     (bar: fn I32 I32 -> String is pure) = fn (_: I32) (_: I32) -> "good"
// 
// implicit (bar2: Bar I32 I32 bar2) = Bar I32 I32 with
//     (bar: fn I32 I32 -> I32 is pure) = fn (_: I32) (_: I32) -> 0
// 
// implicit (bar4: Bar I32 F64 bar4) = Bar I32 F64 with
//     (bar: fn I32 I32 -> F64 is pure) = fn (_: I32) (_: I32) -> 23.2
// 
// (foo: fn _ _ -> _ is pure) (a: _) (b: _) = (error).bar (a: _) (b: _)
// 
// (baz: fn String String -> _ is pure) (x: String) (y: String) = (error).bar (x: String) (y: String)
// 
// (_: _) = (error).bar 3 2
// 
// (_: _) = (error).bar "four" "five"

