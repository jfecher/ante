// Multiple mutually-recursive functions must be typechecked in tandem

is_even n =
    if n == 0 then true else
        print n
        not is_odd (n - 1)

is_odd n =
    n == 1 or not is_even (n - 1)

main () =
    is_even 4
    ()

// args: -e ast-t --no-color
// expected stdout:
// (is_even: fn I32 -> Bool can Fs) (n: I32) =
//     if (eq_i32: Eq I32 pure).== (ref (n: I32)) (ref 0) then true else 
//         (print_i32: Print I32 pure).print (ref (n: I32))
//         (not_bool: Not Bool).not ((is_odd: fn I32 -> Bool can Fs) ((sub_i32: Sub I32).- (n: I32) 1))
// 
// (is_odd: fn I32 -> Bool can Fs) (n: I32) =
//     if (eq_i32: Eq I32 pure).== (ref (n: I32)) (ref 1) then true else (not_bool: Not Bool).not ((is_even: fn I32 -> Bool can Fs) ((sub_i32: Sub I32).- (n: I32) 1))
// 
// (main: fn Unit -> Unit can Fs) () =
//     (is_even: fn I32 -> Bool can Fs) 4
//     ()

