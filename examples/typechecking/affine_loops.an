import Std.Collections.Vec

type Resource = id: I32

consume x = Std.Mem.forget x

// error
move_outer_in_body (r1: Resource) (r2: Resource) =
    for _i in 0..3 do
        consume r1

    while false do
        consume r2

// ok
move_local_in_body () =
    for _i in 0..3 do
        local = Resource 1
        consume local

    while false do
        local = Resource 1
        consume local
        consume (Resource 1)

// ok
move_copy_in_body (x: I32) =
    for _i in 0..3 do
        consume x

    while false do
        consume x

// Moves in a for's range are fine
move_in_start (r: Resource) =
    for _i in (start_consumes r)..3 do ()

start_consumes (r: Resource) : I32 =
    consume r
    0

// The iterated expression only runs once, and each element is owned by the body
move_iterable_and_elements (v: Vec Resource) =
    for r in v do consume r

// This is still an error since we can't track how many times the loop already ran
move_then_break (r: Resource) =
    for _i in 0..3 do
        consume r
        break

// A move in a while's condition should error
move_in_while_condition (r: Resource) =
    while
        consume r
        false
    do ()

main () = ()

impl drop_resource: Drop Resource pure with
    drop _ = ()

