repeat (count: Usz) (f: fn Usz [env] -> Unit can e) {Drop env e}: Unit can e =
    for i in 0 .. count do f i

effect Count =
    count: fn Unit -> Unit

foo (): Unit can Count =
    count ()
    repeat 10 fn _ -> count ()

handle_count (f: once fn Unit => Unit can Count) =
    handle
        f ()
        0
    | count () -> 1 + resume ()

main () =
    handle_count foo
    ()

