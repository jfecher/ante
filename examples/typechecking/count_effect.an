//         (f: fn Unit [_] -> Unit can Count) ()
//         0
//     | (count: fn Unit -> Unit can Count) () -> fn () (resume: fn Unit [Ptr] -> I32 is pure) -> (add_i32: Add I32).+ 1 ((resume: fn Unit [Ptr] -> I32 is pure) ())
// 
