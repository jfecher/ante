effect Count =
    count: fn Unit -> Unit

effect Log =
    log: fn Unit -> Unit

effect Bail =
    bail: fn Unit -> Unit

foo (): Unit can Count, Bail =
    count ()
    bail ()

// Regression test showing the error message quality of this test.
// Previously Bail and Log mismatches were reported in separate errors
handle_count (f: fn Unit => Unit can Count, Bail): I32 can Count =
    handle
        f ()
        0
    | count () ->
        log ()
        1 + resume ()

main () = ()

// args: --check --no-color
// expected exit status: 1
// expected stderr:
// examples/typechecking/handle_closed_row_conflict.an:18:1
// 17 |     handle
// 18 |         f ()	// error: This can perform Bail, Log, _ but only Count is allowed here
//    | ^^^^^^^^^^^^
// 19 |         0
// 
// Found 1 error and 0 warnings

