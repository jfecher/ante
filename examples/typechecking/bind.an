//     switch (match_var7: Maybe _)
//     | 0 -> (Maybe.None: Maybe _)
//     | 1, (match_var8: _) -> 
//             (x: _) = (match_var8: _)
//             (f: once fn _ [env] -> Maybe _ can _) (x: _)
// 
// type Maybe2 t =
//     | None
//     | Some t
// 
// (ret: fn _ -> Maybe _ is pure) (x: _) = (Maybe.Some: fn _ -> Maybe _ is pure) (x: _)
// 
// (x: Maybe I32) = (Maybe.Some: fn I32 -> Maybe I32 is pure) 10_I32
// 
// (add_one: fn (Maybe I32) -> Maybe I32 is pure) (x: Maybe I32) =
//     (bind: fn (Maybe I32) (once fn I32 -> Maybe I32 is pure) {Drop NoClosureEnv pure Unit} -> Maybe I32 is pure) (x: Maybe I32) (fn (x: I32) -> (ret: fn I32 -> Maybe I32 is pure) ((add_i32: Add I32 add_i32).+ (x: I32) 1_I32)) {()}

