// An unused parameter warns, but a `_`-prefixed one does not.
unused_param x = 0
ignored_param _x = 0

// Type variables should never warn
typed (a: t): t = a

// Naming a parameter's place doesn't use the parameter
named_place (x: ref 'x I32): Unit = ()

main () =
    print_to_stdout do
    unused = 1

    used = 2
    print used

    match Maybe.Some used
    | Some bound -> ()
    | None -> ()

// args: -e ast-r --no-color
// expected stdout:
// // id = c1m723_5188
// unused_param_c1m723_5188_0 x_1 = 0
// 
// // id = c1m723_4219
// ignored_param_c1m723_4219_0 _x_1 = 0
// 
// // id = c1m723_2389
// typed_c1m723_2389_0 (a_1: t_2): t_2 is pure = a_1
// 
// // id = c1m723_507
// named_place_c1m723_507_0 (x_1: ref 'x_1 I32): Unit_bUnit is pure = ()
// 
// // id = c1m723_1944
// main_c1m723_1944_0 () =
//     print_to_stdout_c0m703_1603_0 (move fn __4 ->
//         unused_1 = 1
//         used_2 = 2
//         print_c0m703_3948_3 used_2
//         match Maybe.Some_c0m703_5164_3 used_2
//         | Some_td bound_3 -> ()
//         | None_td -> ())


