type Wrap t = inner: t

// A default may refer to earlier parameters
type Nested a (b = Wrap a) (c = b) = first: a, second: b, third: c

// But not to later ones
type Later (a = b) b = x: a

type RequiredAfterDefault (a = I32) b = x: a, y: b

