effect Three =
    one: fn Unit -> Unit
    two: fn I32 -> I32
    three: fn I32 I32 -> I32

effect State a =
    get: fn Unit -> a
    put: fn a -> Unit

main () =
    handle ()
      | one () -> ()
      | one () -> ()

    handle ()
      | get () -> resume ()
      | put () -> ()

    handle ()
      | put () -> ()
      | three 0 1 -> ()

    handle ()
      | get () -> resume ()

