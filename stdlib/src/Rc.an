import Std.C.malloc, free

export Rc, Rc.of, Rc.as_ref, Rc.as_mut, ref_count, inc_ref_count, dec_ref_count,
    Rc.try_unwrap, Rc.unwrap_or_clone, clone_rc, drop_rc

/// A non-threadsafe reference-counted pointer.
type Rc t =
    ptr: Ptr (U32, t)

Rc.of (value: t): Rc t =
    size = size_of (MkType: Type (U32, t))
    ptr = malloc size
    ptr_store ptr (1, value)
    Rc ptr

/// Returns a reference into the inner element
Rc.as_ref (rc: ref 'rc Rc t): ref 'rc! t =
    rc = ptr_to_mut rc.ptr
    rc.second

/// Returns a mutable reference into the inner element
Rc.as_mut (rc: mut 'rc Rc t): mut 'rc! t =
    rc = ptr_to_mut rc.ptr
    rc.second

ref_count (rc: ref Rc t): U32 =
    rc = ptr_to_mut rc.ptr
    rc.first

inc_ref_count (rc: mut Rc t): Unit =
    rc = ptr_to_mut rc.ptr
    rc.first += 1

dec_ref_count (rc: mut Rc t): Unit =
    rc = ptr_to_mut rc.ptr
    rc.first -= 1

/// If the reference count is 1, unwraps the Rc returning the value directly.
/// Otherwise, returns `Error rc` with the original Rc value.
///
/// If you always need to extract the inner value from the Rc, consider
/// using `Rc.unwrap_or_clone` which will clone the inner value in the shared case
/// instead of returning an error.
Rc.try_unwrap (var rc: Rc t): Result t (Rc t) =
    if ref_count rc == 1 then
        // Bit-copy the cell out before freeing. drop_rc does not run drop
        // on the inner t, so this transfers ownership cleanly.
        pair = deref_ptr rc.ptr
        free rc.ptr
        // Mark this Rc as consumed so drop_rc skips it on scope exit.
        rc.ptr := null ()
        Ok pair.second
    else
        Error rc

/// If the reference count is 1, unwraps the Rc returning the value directly.
/// Otherwise, clones the inner value.
Rc.unwrap_or_clone (rc: Rc t) {Clone t}: t =
    match Rc.try_unwrap rc
    | Ok v -> v
    | Error rc2 -> clone (Rc.as_ref rc2)

impl clone_rc: Clone (Rc t) with
    clone (rc: ref Rc t) =
        // transmute ref -> mut
        inc_ref_count (transmute rc)
        deref rc

impl drop_rc {Drop t e}: Drop (Rc t) e with
    drop (rc: mut Rc t) =
        // Skip cells consumed by try_unwrap.
        if rc.ptr == null () then
            ()
        else if ref_count rc == 1 then
            ptr = ptr_to_mut rc.ptr
            drop ptr.second
            free rc.ptr
        else
            dec_ref_count rc
