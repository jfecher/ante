import Std.C.malloc, realloc, memcpy, free, calloc
import Std.Stream.Stream, iter, emit
import Std.Fail.Fail, fail, panic_on_fail
import Std.Mem.Type, MkType, size_of, transmute, null, offset, deref_ptr, ptr_to_ref, array_insert
import Std.Slice.Slice

export Vec, Vec.empty, Vec.of, Vec.is_empty, Vec.len, Vec.extend, Vec.capacity, Vec.reserve, Vec.push, Vec.pop, Vec.get, Vec.get_unchecked,
    Vec.remove_index, Vec.remove_first, Vec.remove_indices, Vec.remove_all, Vec.swap_last,
    Vec.reverse, Vec.swap, Vec.insert, Vec.dedup, Vec.truncate, Vec.clear, Vec.sort_by, Vec.sort,
    Vec.windows, Vec.chunks, Vec.permutations,
    print_vec, extract_vec, stream_vec, stream_ref_vec, eq_vec, cmp_vec, clone_vec, drop_vec, insert_vec

type Vec t =
    data: Ptr t
    len: Usz
    cap: Usz

Vec.empty () = Vec (null ()) 0 0

Vec.is_empty (v: ref Vec a) = v.len == 0

Vec.len (v: ref Vec a) = v.len

Vec.capacity (v: ref Vec a) = v.cap

/// Create a new Vec with the elements from the given stream
Vec.of (stream: s) {Stream s t e}: Vec t can Panic, e =
    var vec = Vec.empty ()
    vec.extend stream
    vec

Vec.extend (vec: mut Vec t) (stream: s) {Stream s t e}: Unit can Panic, e, Mutate 'vec =
    iter stream (vec.push _)

/// Reserve space for `numElems` more elements in `v`. The new slots are uninitialized.
Vec.reserve (v: mut Vec t) (numElems: Usz): Unit can Panic, Mutate 'v =
    if v.len + numElems > v.cap then
        size = (v.cap + numElems) * size_of (MkType: Type t)
        ptr = realloc v.data size

        if ptr == null () then
            panic "Error in reserving more elements for Vec"

        v.data := ptr
        v.cap := v.cap + numElems

/// Push an element onto the end of the vector.
/// Resizes if necessary.
Vec.push (v: mut Vec t) (elem: t): Unit can Panic, Mutate 'v =
    if v.len >= v.cap then
        v.reserve (if v.cap == 0 then 1 else v.cap)

    array_insert v.data v.len elem
    v.len += 1

/// Removes the last element of this vector and returns it.
/// Returns None if the vector is empty.
Vec.pop (v: mut Vec t): Maybe t can Mutate 'v =
    if v.is_empty () then None
    else
        v.len -= 1
        Some (deref_ptr (offset v.data v.len))

/// Retrieves a reference to the element at the given 0-based index.
/// Fails if the index is out of bounds
Vec.get (v: ref Vec t) (i: Usz): ref! t can Fail =
    if i < v.len
    then v.get_unchecked i
    else fail ()

/// An unsafe function to retrieve an element at the given index
/// without checking if the index is inbounds
Vec.get_unchecked (v: ref Vec t) (i: Usz): ref! t =
    ptr = offset v.data i
    transmute ptr

/// Remove the element at the given index and return it.
/// will Fail if the index is out of bounds.
Vec.remove_index (v: mut Vec t) (idx: Usz): t can Fail, Mutate 'v =
    if idx >= 0 and idx < v.len then
        item = v.get_unchecked idx |> deref
        for i in idx .. v.len - 1 do
            array_insert v.data i (deref_ptr (offset v.data (i+1)))

        v.len -= 1
        item
    else
        fail ()

/// Removes the first instance of the given element from the vector,
/// returning the index it was found at. Returns `None` if the element was not found.
Vec.remove_first (v: mut Vec t) (elem: t) {Eq t e} {Copy t}: Maybe Usz can Panic, e, Mutate 'v =
    for i in 0 .. v.len do
        if elem == v.data.[i] then
            v.remove_index i ~> panic_on_fail
            return Some i
    None

/// Remove the given indices from the vector
/// Expects the indices to be in sorted order.
/// Will Fail if any index is out of bounds.
Vec.remove_indices (v: mut Vec t) (idxs: Vec Usz): Unit can Fail, Mutate 'v =
    var moved = 0usz
    for i in 0 .. idxs.len do
        cur = idxs.data.[i]

        if cur < 0 or cur >= v.len then
            fail ()

        moved += 1
        if i != idxs.len - 1 then
            nxt = idxs.data.[i + 1]
            for j in 0 .. (nxt - cur - 1) do
                j = j + cur + 1
                array_insert v.data (j - moved) (v.get_unchecked j |> deref)
        else
            for j in 0 .. (v.len - cur - 1) do
                j = j + cur + 1
                array_insert v.data (j - moved) (v.get_unchecked j |> deref)

    v.len -= moved

/// Remove all matching elements from the vector and
/// return the number of elements removed.
/// Uses = to determine element equality.
Vec.remove_all (v: mut Vec t) (elem: t) {Eq t e} {Copy t}: Usz can Panic, e, Mutate 'v =
    var idxs = Vec.empty ()
    for i in 0 .. v.len do
        if elem == v.data.[i] then
            idxs.push i

    count = idxs.len
    v.remove_indices idxs ~> panic_on_fail
    count


/// Remove an element by swapping it with the last element in O(1) time.
/// Returns true if a swap was performed or false otherwise.
/// Will not swap if the given index is the index of the last element.
Vec.swap_last (v: mut Vec t) (idx: Usz) : Bool can Mutate 'v =
    if idx >= v.len or idx + 1 == v.len then false
    else
        v.len := v.len - 1
        array_insert v.data idx (deref_ptr (offset v.data v.len))
        true

/// Reverse the elements of this vector in place.
Vec.reverse (v: mut Vec t): Unit can Mutate 'v! =
    if v.len < 2 then return ()
    half = v.len / 2
    for i in 0 .. half do
        opposite = v.len - i - 1
        tmp = deref_ptr (offset v.data i)
        array_insert v.data i (deref_ptr (offset v.data opposite))
        array_insert v.data opposite tmp

/// Swap the elements at indices `i` and `j`. Fails if either index is out of bounds.
Vec.swap (v: mut Vec t) (i: Usz) (j: Usz): Unit can Fail, Mutate 'v! =
    if i >= v.len or j >= v.len then fail ()
    if i == j then return ()
    tmp = deref_ptr (offset v.data i)
    array_insert v.data i (deref_ptr (offset v.data j))
    array_insert v.data j tmp

/// Insert `elem` at `idx`, shifting elements at `[idx, len)` one position right.
/// Fails if `idx > len`.
Vec.insert (v: mut Vec t) (idx: Usz) (elem: t): Unit can Fail, Panic, Mutate 'v =
    if idx > v.len then fail ()
    if v.len >= v.cap then
        v.reserve (if v.cap == 0 then 1 else v.cap)
    var i = v.len
    while i > idx do
        array_insert v.data i (deref_ptr (offset v.data (i - 1)))
        i -= 1
    array_insert v.data idx elem
    v.len += 1

/// Remove consecutive runs of equal elements, keeping only the first of each run.
Vec.dedup (v: mut Vec t) {Eq t e} {Copy t}: Unit can e, Mutate 'v =
    if v.len < 2 then return ()
    var write = 1
    for i in 1 .. v.len do
        if v.data.[i] != v.data.[write - 1] then
            if write != i then
                array_insert v.data write (deref_ptr (offset v.data i))
            write += 1
    v.len := write

/// Shrink the vector to at most `new_len` elements, dropping any tail.
/// Does nothing if `new_len >= v.len`.
Vec.truncate (v: mut Vec t) (new_len: Usz) {Drop t e}: Unit can e, Mutate 'v =
    if new_len >= v.len then return ()
    for i in new_len .. v.len do
        elem = offset v.data i
        Drop.drop (ptr_to_ref elem)
    v.len := new_len

/// Remove and drop every element.
/// After being cleared, a Vec's length will be zero, but its capacity will be unchanged.
Vec.clear (v: mut Vec t) {Drop t e}: Unit can e, Mutate 'v =
    v.truncate 0

insertion_sort (data: Ptr t) (start: Usz) (end: Usz) (cmp: fn (ref t) (ref t) => Bool): Unit =
    for i in (start + 1) .. end do
        elem = deref_ptr (offset data i)
        var j = i
        while j > start and cmp (ref elem) (ptr_to_ref (offset data (j - 1))) do
            array_insert data j (deref_ptr (offset data (j - 1)))
            j -= 1
        array_insert data j elem

merge_runs (src: Ptr t) (dst: Ptr t) (lo: Usz) (mid: Usz) (hi: Usz) (cmp: fn (ref t) (ref t) => Bool): Unit =
    elem_size = size_of (MkType: Type t)
    var left = lo
    var right = mid
    var out = lo
    while left < mid and right < hi do
        if cmp (ptr_to_ref (offset src right)) (ptr_to_ref (offset src left)) then
            array_insert dst out (deref_ptr (offset src right))
            right += 1
        else
            array_insert dst out (deref_ptr (offset src left))
            left += 1
        out += 1
    memcpy (offset dst out) (offset src left) ((mid - left) * elem_size)
    memcpy (offset dst (out + mid - left)) (offset src right) ((hi - right) * elem_size)
    ()

merge_sort (data: Ptr t) (n: Usz) (cmp: fn (ref t) (ref t) => Bool): Unit =
    run_len = 16usz
    var run_start = 0usz
    while run_start < n do
        run_end = if n - run_start < run_len then n else run_start + run_len
        insertion_sort data run_start run_end cmp
        run_start := run_end

    if n <= run_len then return ()

    elem_size = size_of (MkType: Type t)
    buffer: Ptr t = malloc (n * elem_size)
    var src = data
    var dst = buffer
    var width = run_len
    while width < n do
        var lo = 0usz
        while lo < n do
            mid = if n - lo < width then n else lo + width
            hi = if n - mid < width then n else mid + width
            merge_runs src dst lo mid hi cmp
            lo := hi
        tmp = src
        src := dst
        dst := tmp
        width *= 2

    if src != data then
        memcpy data src (n * elem_size)
    free buffer

/// Sort the vector in place using `cmp` to compare elements.
Vec.sort_by (v: mut Vec t) (cmp: fn (ref t) (ref t) => Bool): Unit can Mutate 'v! =
    merge_sort v.data v.len cmp

/// Sort the vector in place using the `Cmp` ordering.
Vec.sort (v: mut Vec t) {Cmp t}: Unit can Mutate 'v! =
    v.sort_by (<)

Vec.windows (v: ref 'v Vec t) (n: Usz) = fn () can Emit (Slice 'v t) ->
    if n != 0 and n <= v.len then
        for i in 0 .. v.len - n + 1 do
            emit (Slice (transmute (offset v.data i)) n)

Vec.chunks (v: ref 'v Vec t) (n: Usz) = fn () can Emit (Slice 'v t) ->
    if n != 0 then
        var start = 0usz
        while start < v.len do
            len = if v.len - start < n then v.len - start else n
            emit (Slice (transmute (offset v.data start)) len)
            start += len

Vec.permutations (v: ref 'v Vec t) = fn () can Emit (Slice 'v t) ->
    n = v.len
    elem_size = size_of (MkType: Type t)
    buffer: Ptr t = malloc (n * elem_size)
    memcpy buffer v.data (n * elem_size)
    counters: Ptr Usz = calloc n (size_of (MkType: Type Usz))

    emit (Slice (transmute buffer) n)
    var i = 1usz
    while i < n do
        count = deref_ptr (offset counters i)
        if count < i then
            other = if i % 2 == 0 then 0 else count
            tmp = deref_ptr (offset buffer other)
            array_insert buffer other (deref_ptr (offset buffer i))
            array_insert buffer i tmp
            emit (Slice (transmute buffer) n)
            array_insert counters i (count + 1)
            i := 1
        else
            array_insert counters i 0
            i += 1

    free buffer
    free counters

impl print_vec {p: Display t e}: Display (Vec t) e with
    print v =
        print "["

        for i in 0 .. v.len do
            if i != 0 then print ", "
            elem: t = deref_ptr (offset v.data i)
            print elem

        print "]"

impl extract_vec: Extract (ref 'v Vec t) Usz (ref 'v! t) Panic with
    (.[]) v i =
        if i >= v.len () then
            panic "Vec index out of bounds"
        transmute (offset v.data i)

/// Note that this impl is different from `Vec.insert`.
/// Vec.insert will insert into a slot, moving the previous element and each
/// element after to the right. This `Insert` implementation will instead
/// directly mutate the element at the given index to the new element.
impl insert_vec: Insert (mut 'v Vec t) Usz t (Panic & Mutate 'v!) with
    (.[]:=) v i e =
        slot = v.get i ~> panic_on_fail
        slot := e

impl stream_vec: Stream (Vec a) a pure with
    stream vec =
        for i in 0 .. vec.len do
            emit (deref (vec.get_unchecked i))

impl stream_ref_vec: Stream (ref Vec a) (ref a) pure with
    stream vec =
        for i in 0 .. vec.len do
            emit (vec.get_unchecked i)

impl clone_vec {Clone t}: Clone (Vec t) with
    clone v =
        if v.len == 0 then
            return Vec.empty ()

        data: Ptr t = malloc (v.len * size_of (MkType: Type t))
        for i in 0 .. v.len do
            array_insert data i (clone (v.get_unchecked i))
        Vec data v.len v.len

impl drop_vec {Drop t e}: Drop (Vec t) e with
    drop (v: mut Vec t) =
        if v.cap != 0 then
            for i in 0 .. v.len do
                elem = offset v.data i
                Drop.drop (ptr_to_ref elem)
            free v.data

impl eq_vec {Eq t e}: Eq (Vec t) e with
    (==) l r =
        if l.len != r.len then
            return false

        for i in 0 .. l.len do
            le = l.data.[i]
            re = r.data.[i]
            if le != re then
                return false
        true

impl cmp_vec {Cmp t}: Cmp (Vec t) with
    (<) l r =
        n = if l.len < r.len then l.len else r.len
        for i in 0 .. n do
            a = l.get_unchecked i
            b = r.get_unchecked i
            if a < b then return true
            if b < a then return false
        l.len < r.len
