import Std.C.fclose, fopen, fwrite, fgetc, fread, ungetc, feof, ferror, malloc, realloc, free, getchar, copy_file
import Std.C
import Std.Fail.Fail, fail, fail_if
import Std.Stream.iter, stream_fn, foldl
import Std.Mem.transmute, null, array_insert, offset
import Std.String.is_valid_utf8_bytes
import Std.Iterator.Iterator

export File, File.open, File.close, drop_file, File.eof, File.write, File.next_char, File.next_line,
    iterator_file, read_line, read_file, read_file_bytes, print_to_file, create_dir, create_dir_all

type File = c_file: C.File

/// Open the file at `path` with the given `fopen` mode.
/// Fails if it cannot be opened.
///
/// This function is temporary, mode will eventually become a union, and `path` a proper path type.
File.open (path: String) (mode: String): File can Fs, Fail =
    c_file = fopen (C.String.new path) (C.String.new mode)
    fail_if (c_file.f == null ())
    File c_file

File.close (file: File): Unit can Fs =
    fclose file.c_file

impl drop_file: Drop File Fs with
    drop f =
        fclose f.c_file

/// Convenience function for using feof with better types
File.eof (f: ref File): Bool can Fs =
    feof f.c_file != 0

File.write (f: mut File) (text: String): Unit can Fs =
    fwrite (transmute text.data) 1 (Usz text.length) f.c_file
    ()

/// Handles `Print` by writing everything printed to `file`
print_to_file (file: ref File) (f: a can Print, e): a can Fs, e =
    print_to_sink (fn data len -> ignore (fwrite (transmute data) 1 len file.c_file)) f

/// Read the next character.
/// Fails if at the end of the file or on a read error.
File.next_char (f: ref File): Char can Fs, Fail =
    c = fgetc f.c_file
    fail_if (c < 0)
    Char c

File.next_line (f: mut File): String can Fs =
    if f.eof () then return ""

    len, cstr = loop (len = 0) (capacity = 32) (cstr = malloc 32) ->
        next = fgetc f.c_file
        if next < 0 then return (len, cstr)
        c = Char next

        //Flag feof if eof occurs after terminating newline
        if c == '\n' then
            peek = fgetc f.c_file
            if peek >= 0 then ungetc peek f.c_file
            return (len, cstr)

        new_capacity, new_cstr = if len + 1 >= capacity then
            new_cap = capacity * 2
            (new_cap, realloc cstr new_cap)
        else (capacity, cstr)

        array_insert new_cstr len c
        recur (len + 1) new_capacity new_cstr

    array_insert cstr len '\0'
    String.from_parts cstr (U32 len)

/// Iterating through a File iterates through each line
impl iterator_file: Iterator (mut File) String Fs with
    next file =
        if file.eof () then None
        else Some (file, file.next_line ())

/// Read a line from stdin, ending with (and not including) a terminating '\n'
read_line (): String can Fs =
    buffer, len = loop (buffer = null ()) (len = 0) ->
        c = getchar ()
        c_char = Char c

        buffer2 = if len %% 32
            then realloc buffer (len + 32)
            else buffer

        array_insert buffer2 len c_char

        if c_char != '\n' and c >= 0
        then recur buffer2 (len + 1)
        else buffer2, len

    array_insert buffer len '\0'
    String.from_parts buffer (U32 len)

read_file_bytes (path: String): Vec U8 can Fs, Fail =
    file = File.open path "rb"
    var capacity = 4096usz
    var data: Ptr U8 = malloc capacity
    var len = 0usz

    while data != null () do
        len += fread (offset data len) 1 (capacity - len) file.c_file
        if len < capacity then break
        capacity *= 2
        data := realloc data capacity

    read_error = data == null () or ferror file.c_file != 0
    file.close ()
    fail_if read_error
    Vec data len capacity

read_file (path: String): String can Fs, Fail =
    bytes = read_file_bytes path
    fail_if (bytes.len > 0xFFFF_FFFF)
    fail_if (not is_valid_utf8_bytes bytes.data bytes.len)
    String.from_parts (transmute bytes.data) (U32 bytes.len)

create_dir_: fn C.String -> I32 can Fs = extern "ante_create_dir"

/// Create the directory at `path`.
/// Fails if it cannot be created, unless a directory already exists there.
create_dir (path: String): Unit can Fs, Fail =
    fail_if <| create_dir_ (C.String.new path) != 0

/// Create each directory in `path` along with any missing parent directories.
/// Fails if any of them cannot be created.
create_dir_all (path: String): Unit can Fs, Fail =
    path.split '/' |> foldl "" fn prefix component ->
        if component.length == 0 then
            // An empty first component means the path is absolute.
            if prefix.length == 0 then "/" else prefix
        else
            prefix = prefix ++ component ++ "/"
            create_dir (clone prefix)
            prefix
    ()
