import Std.Mem.transmute
import Std.Bitwise.bxor, shr, bitwise_u64
import Std.Num.wrapping_add, wrapping_mul, wrapping_u64

trait Hash t =
    hash: fn (ref t) -> U64

/// FNV-1a 64-bit with an offset basis of 14695981039346656037 (0xcbf29ce484222325),
/// and prime of 1099511628211 (0x100000001b3).
impl hash_string: Hash String with
    hash s =
        var hash = 14695981039346656037u64
        for i in 0 .. Usz s.length do
            byte: Char = deref_ptr (offset s.data i)
            hash := wrapping_mul (bxor hash (U64 byte)) 1099511628211
        hash

impl hash_u64: Hash U64 with
    hash x = x.*

impl hash_u8: Hash U8 with
    hash x = cast x.*

impl hash_u16: Hash U16 with
    hash x = cast x.*

impl hash_u32: Hash U32 with
    hash x = cast x.*

impl hash_usz: Hash Usz with
    hash x = cast x.*

impl hash_i8: Hash I8 with
    hash x = cast (transmute x.* : U8)

impl hash_i16: Hash I16 with
    hash x = cast (transmute x.* : U16)

impl hash_i32: Hash I32 with
    hash x = cast (transmute x.* : U32)

impl hash_i64: Hash I64 with
    hash x = transmute x.*

impl hash_isz: Hash Isz with
    hash x = cast (transmute x.* : Usz)

impl hash_f32: Hash F32 with
    hash x = cast (transmute x.* : U32)

impl hash_f64: Hash F64 with
    hash x = transmute x.*

impl hash_bool: Hash Bool with
    hash b = if b.* then 1 else 0

impl hash_char: Hash Char with
    hash c = U64 c.*

/// Combine two hashes to form a new one. This is order-sensitive so (a, b) and
/// (b, a) hash differently. Uses a mixing constant of 2^64 / phi.
hash_combine (h1: U64) (h2: U64): U64 =
    h = wrapping_mul (wrapping_add (wrapping_mul h1 11400714819323198485) h2) 18397679294719823053
    bxor h (shr h 32)

impl hash_pair {Hash a} {Hash b}: Hash (a, b) with
    hash p = hash_combine (Hash.hash p.first) (Hash.hash p.second)

impl hash_maybe {Hash a}: Hash (Maybe a) with
    hash m =
        match m
        | None -> 0
        | Some x -> hash_combine 1 (Hash.hash x)

impl hash_result {Hash a} {Hash e}: Hash (Result a e) with
    hash r =
        match r
        | Ok x -> hash_combine 2 (Hash.hash x)
        | Error e -> hash_combine 3 (Hash.hash e)
