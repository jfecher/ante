import Std.C.calloc, free
import Std.Hash.type
import Std.Mem.Type, null, ref_to_ptr, forget

export HashMap, Entry, Hash, empty, of, clear, resize, should_resize,
    insert, get_entry, get, contains, remove, len,
    is_empty, keys, values, get_or_insert, get_or_insert_with, retain,
    merge, extend, print_hashmap, stream_map, stream_ref_map, eq_hashmap, clone_hashmap, drop_hashmap, drop_entry, extract_hashmap, insert_hashmap

/// A linear-scan mutable HashMap using a resize factor of 2.0
///
/// HashMaps store their Hash impl upon construction to ensure two HashMaps
/// used for merging, equality, etc. use the same impl.
type HashMap k v (h = _) =
    hasher: Hash k h
    len: Usz
    capacity: Usz
    entries: Ptr (Entry k v)

type Entry k v =
    key: k
    value: v
    occupied: Bool
    tombstone: Bool

/// Returns the length of this HashMap
len (m: ref HashMap k v): Usz = m.len

/// Returns true if this HashMap is empty. Equivalent to `map.len () == 0`
is_empty (m: ref HashMap k v): Bool = m.len == 0

/// Create a new, empty HashMap
/// This will not allocate until the first entry is inserted.
empty () {hasher: Hash k h}: HashMap k v h = HashMap hasher 0 0 (null ())

/// Create a HashMap containing each `k, v` pair from the given stream.
of (stream: s) {Stream s (k, v) e} {Hash k h} {Eq k e} {Drop k d} {Drop v d}: HashMap k v h can Panic, e, d =
    var map = empty ()
    extend map stream
    map

extend (map: mut HashMap k v) (stream: s) {Stream s (k, v) e} {Eq k e} {Drop k d} {Drop v d}: Unit can Panic, e, d, Mutate 'map =
    iter stream (fn (k, v) -> ignore (insert map k v))

clear (map: mut HashMap k v) {Drop k d} {Drop v d}: Unit can d, Mutate 'map =
    if map.capacity != 0 then
        for i in 0 .. map.capacity do
            entry_ptr = offset map.entries i
            entry = ptr_to_ref entry_ptr
            if entry.occupied then
                drop (deref_ptr entry_ptr)
            entry.occupied := false
            entry.tombstone := false
        map.len := 0usz

resize (map: mut HashMap k v) (new_capacity: Usz) {Eq k e}: Unit can Panic, e, Mutate 'map =
    if new_capacity > map.capacity then
        new_memory = calloc new_capacity (size_of (MkType : Type (Entry k v)))

        if new_memory == null () then
            panic "Ran out of memory while resizing HashMap"

        old_entries = map.entries
        map.entries := new_memory

        old_capacity = map.capacity
        map.capacity := new_capacity

        // Each entry is moved to its slot in the new table, so the old table is freed as is
        for i in 0 .. old_capacity do
            entry_ptr = offset old_entries i
            old = ptr_to_ref entry_ptr
            if old.occupied then
                index, _ = slot_for map old.key
                ptr_store (offset map.entries index) (deref_ptr entry_ptr)

        if old_capacity != 0 then
            free old_entries

/// Should we resize this map when pushing another element?
should_resize (map: ref HashMap k v) : Bool =
    scale_factor = 2
    (map.len + 1) * scale_factor > map.capacity

slot_for (map: ref HashMap k v) (key: ref k) {Eq k e}: (Usz, Bool) can Panic, e =
    var first_tombstone = Maybe.None
    var index = Usz (Hash.hash key {map.hasher}) % map.capacity
    var probes = 0usz

    while probes < map.capacity do
        entry = ptr_to_ref (offset map.entries index)
        if entry.occupied then
            if entry.key == key then
                return (index, true)
        else if entry.tombstone then
            if first_tombstone is None then
                first_tombstone := Some index
        else
            slot = unwrap_or_else first_tombstone do index
            return (slot, false)

        index += 1
        if index == map.capacity then index := 0
        probes += 1

    match first_tombstone
    | Some tombstone -> (tombstone, false)
    | None -> panic "Failed to insert entry into map"

entry_for (map: mut HashMap k v) (key: ref k) {Eq k e}: (Ptr (Entry k v), Bool) can Panic, e, Mutate 'map =
    if should_resize map then
        resize map ((map.capacity + 1) * 2)

    index, found = slot_for map key
    (offset map.entries index, found)

/// Inserts a key-value pair into the map, removing any item that may previously
/// have been associated with the same key and returning the removed value if there was one.
insert (map: mut HashMap k v) (key: k) (value: v) {Eq k e} {Drop k d}: Maybe v can Panic, e, d, Mutate 'map =
    entry_ptr, found = entry_for map (ref key)
    if found then
        // The entry keeps the key it has, so only its value is replaced
        entry = ptr_to_ref entry_ptr
        previous = deref entry.value
        ptr_store (ref_to_ptr entry.value) value
        Some previous
    else
        ptr_store entry_ptr (Entry key value true false)
        map.len := map.len + 1usz
        None

get_entry (map: ref 'm HashMap k v h) (key: ref k) {eq: Eq k e}: Maybe (ref 'm! (Entry k v)) can e =
    if map.capacity == 0 then return None

    var index = Usz (Hash.hash key {map.hasher}) % map.capacity
    var probes = 0usz

    while probes < map.capacity do
        entry_ptr = offset map.entries index
        entry = ptr_to_ref entry_ptr
        if entry.occupied then
            if entry.key == key then
                return Some (ptr_to_ref entry_ptr)
        else if not entry.tombstone then
            return None

        index += 1
        if index == map.capacity then index := 0
        probes += 1

    None

get (map: ref 'm HashMap k v) (key: ref k) {Eq k e}: ref 'm! v can Fail, e =
    match get_entry map key
    | Some entry -> entry.value
    | None -> fail ()

contains (map: ref HashMap k v) (key: ref k) {Eq k e}: Bool can e =
    try (do get map key) is Some _

remove (map: mut HashMap k v) (key: ref k) {Eq k e} {Drop k d}: Maybe v can e, d, Mutate 'map =
    match get_entry map key
    | None -> None
    | Some entry ->
        entry.occupied := false
        entry.tombstone := true
        key = deref entry.key
        value = deref entry.value
        map.len := map.len - 1
        drop key
        Some value

impl print_hashmap {Display k e} {Display v e}: Display (HashMap k v) e with
    print map =
        write "["
        var printed_first = false
        for i in 0 .. map.capacity do
            entry = ptr_to_ref (offset map.entries i)
            if entry.occupied then
                if printed_first then
                    print ", "

                print entry.key
                print " -> "
                print entry.value
                printed_first := true

        write "]"

impl stream_map: Stream (HashMap k v) (k, v) pure with
    stream map =
        for i in 0 .. map.capacity do
            entry_ptr = offset map.entries i
            if (ptr_to_ref entry_ptr).occupied then
                entry: Entry k v = deref_ptr entry_ptr
                emit (entry.key, entry.value)

        // Every entry was moved out, so only the table is left to free
        if map.capacity != 0 then
            free map.entries
        forget map

impl stream_ref_map: Stream (ref 'm HashMap k v) (ref 'm k, ref 'm v) pure with
    stream map =
        for i in 0 .. map.capacity do
            entry: ref 'm (Entry k v) = ptr_to_ref (offset map.entries i)
            if entry.occupied then
                key: ref 'm k = entry.key
                value: ref 'm v = entry.value
                emit (key, value)

/// Emit a reference to each key
keys (m: ref 'm HashMap k v) = move fn () can Emit (ref 'm k) ->
    for i in 0 .. m.capacity do
        entry: ref 'm (Entry k v) = ptr_to_ref (offset m.entries i)
        if entry.occupied then
            key: ref 'm k = entry.key
            emit key

/// Emit a reference to each value
values (m: ref 'm HashMap k v) = move fn () can Emit (ref 'm v) ->
    for i in 0 .. m.capacity do
        entry: ref 'm (Entry k v) = ptr_to_ref (offset m.entries i)
        if entry.occupied then
            value: ref 'm v = entry.value
            emit value

/// Return the existing value at `key`, or insert `default` and return it.
get_or_insert (m: mut 'm HashMap k v) (key: k) (default: v) {Eq k e} {Drop k d} {Drop v d}: ref 'm! v can Panic, e, d, Mutate 'm =
    entry_ptr, found = entry_for m (ref key)
    if not found then
        ptr_store entry_ptr (Entry key default true false)
        m.len += 1
    entry = ptr_to_ref entry_ptr
    entry.value

/// Same as `get_or_insert` but builds the default lazily.
get_or_insert_with (m: mut 'm HashMap k v) (key: k) (mk: once fn Unit [env] -> v) {Eq k e} {Drop k d} {Drop env d}: ref 'm! v can Panic, e, d, Mutate 'm =
    entry_ptr, found = entry_for m (ref key)
    if not found then
        ptr_store entry_ptr (Entry key (mk ()) true false)
        m.len += 1
    entry = ptr_to_ref entry_ptr
    entry.value

/// Remove every entry for which `pred key value` returns false.
retain (m: mut HashMap k v) (pred: fn (ref k) (mut v) [env] -> Bool) {Drop k d} {Drop v d} {Drop env d}: Unit can d, Mutate 'm =
    for i in 0 .. m.capacity do
        entry_ptr = offset m.entries i
        entry = ptr_to_ref entry_ptr
        if entry.occupied then
            if not (pred entry.key entry.value) then
                entry.occupied := false
                entry.tombstone := true
                m.len -= 1
                drop (deref_ptr entry_ptr)

/// Insert every entry from `src` into `dst`, overwriting on conflict.
/// Both maps must hash their keys with the same `Hash` impl.
merge (dst: mut HashMap k v h) (src: HashMap k v h) {Eq k e} {Drop k d} {Drop v d}: Unit can Panic, Mutate 'dst, e, d =
    iter src (fn (k, v) -> ignore (insert dst k v))

impl extract_hashmap {Eq k e}: Extract (ref 'm HashMap k v) (ref k) (ref 'm! v) (Panic & e) with
    (.[]) map key = get map key ~> panic_on_fail

impl insert_hashmap {Eq k e} {Drop k d} {Drop v d}: Insert (mut 'm HashMap k v) k v (Panic & Mutate 'm & e & d) with
    (.[]:=) map key value =
        insert map key value
        ()

impl clone_hashmap {Clone k} {Clone v}: Clone (HashMap k v) with
    clone map =
        if map.capacity == 0 then
            return HashMap map.hasher 0 0 (null ())

        new_memory: Ptr (Entry k v) = calloc map.capacity (size_of (MkType : Type (Entry k v)))
        for i in 0 .. map.capacity do
            old = ptr_to_ref (offset map.entries i)
            new = ptr_to_ref (offset new_memory i)
            new.tombstone := old.tombstone
            if old.occupied then
                ptr_store (offset new_memory i) (Entry (clone old.key) (clone old.value) true false)
        HashMap map.hasher map.len map.capacity new_memory

impl drop_entry {Drop k d} {Drop v d}: Drop (Entry k v) d with
    drop _ = ()

impl drop_hashmap {Drop k d} {Drop v d}: Drop (HashMap k v h) d with
    drop map =
        for i in 0 .. map.capacity do
            entry_ptr = offset map.entries i
            if (ptr_to_ref entry_ptr).occupied then
                drop (deref_ptr entry_ptr)

        if map.capacity != 0 then
            free map.entries

impl eq_hashmap {Eq k e} {Eq v e}: Eq (HashMap k v) e with
    (==) map1 map2 =
        if len map1 != len map2 then
            return false

        for i in 0 .. map1.capacity do
            entry1 = ptr_to_ref (offset map1.entries i)
            if entry1.occupied then
                match get_entry map2 entry1.key
                | None -> return false
                | Some entry2 ->
                    if entry1.value != entry2.value then
                        return false
        true
