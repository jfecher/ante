// Other casts: TODO fill in
impl cast_i32_usz: Cast I32 Usz pure with
    cast x =
        // TODO: Review. Does this match C?
        transmute (cast x : Isz)

impl cast_usz_i64: Cast Usz I64 pure with cast x = intrinsic "ZeroExtend" x
impl cast_i64_usz: Cast I64 Usz pure with cast x = intrinsic "Truncate" x

// This impl needs to be removed if chars become 32-bit
impl cast_char_u8:  Cast Char U8  pure with cast x = intrinsic "ZeroExtend" x
impl cast_char_i32: Cast Char I32 pure with cast x = intrinsic "ZeroExtend" x
impl cast_char_u64: Cast Char U64 pure with cast x = intrinsic "ZeroExtend" x

impl cast_bool_i32: Cast Bool I32 pure with cast b = if b then 1 else 0

// TODO: String interpolation desugars to `Cast x String`, it should use `Display` instead.
count_digits (x: U64): U32 =
    loop x (sum = 1) ->
        if x < 10 then sum
        else recur (x / 10) (sum + 1)

/// Format `magnitude` in decimal, prefixed with `-` when `negative`
decimal_string (var magnitude: U64) (negative: Bool): String =
    sign_length: U32 = if negative then 1 else 0
    len = count_digits magnitude + sign_length
    buf: Ptr Char = malloc (Usz len)
    if negative then
        ptr_store buf '-'

    var pos = Usz (len - 1)
    while
        digit = magnitude % 10 + U64 '0'
        array_insert buf pos (Char digit)
        magnitude /= 10
        pos -= 1
        magnitude > 0
    do ()
    String.from_parts buf len

unsigned_to_string (x: U64): String = decimal_string x false

signed_to_string (x: I64): String =
    // Negating the minimum I64 overflows, so offset by one before negating
    if x < 0 then decimal_string (transmute (0 - (x + 1)) + 1) true
    else decimal_string (transmute x) false

impl cast_u8_string:  Cast U8  String pure with cast x = unsigned_to_string (U64 x)
impl cast_u16_string: Cast U16 String pure with cast x = unsigned_to_string (U64 x)
impl cast_u32_string: Cast U32 String pure with cast x = unsigned_to_string (U64 x)
impl cast_u64_string: Cast U64 String pure with cast x = unsigned_to_string x
impl cast_usz_string: Cast Usz String pure with cast x = unsigned_to_string (U64 x)
impl cast_i8_string:  Cast I8  String pure with cast x = signed_to_string (I64 x)
impl cast_i16_string: Cast I16 String pure with cast x = signed_to_string (I64 x)
impl cast_i32_string: Cast I32 String pure with cast x = signed_to_string (I64 x)
impl cast_i64_string: Cast I64 String pure with cast x = signed_to_string x
impl cast_isz_string: Cast Isz String pure with cast x = signed_to_string (I64 x)

impl cast_char_string: Cast Char String pure with
    cast c =
        buf: Ptr Char = malloc 1
        ptr_store buf c
        String.from_parts buf 1

impl cast_bool_string: Cast Bool String pure with
    cast b = if b then "true" else "false"

float_to_string (f: F64): String =
    is_neg = f < 0.0
    abs = if is_neg then 0.0 - f else f
    uint = U64 abs
    fraction = U64 ((abs - F64 uint) * 10_000.0)
    prefix = if is_neg then "-" else ""
    prefix ++ unsigned_to_string uint ++ "." ++ unsigned_to_string fraction

impl cast_f32_string: Cast F32 String pure with
    cast f = float_to_string (F64 f)

impl cast_f64_string: Cast F64 String pure with
    cast = float_to_string

/// Represents a failable type cast from a to b
trait TryCast a b (e: effect) =
    try_cast: fn a -> b can Fail, e

impl try_cast_from_cast {Cast a b e}: TryCast a b e with
    try_cast a = cast a

impl try_cast_i64_u64: TryCast I64 U64 pure with
    try_cast (x: I64) =
        fail_if (x < 0)
        transmute x

impl try_cast_u64: TryCast U64 I64 pure with
    try_cast (x: U64) =
        fail_if (x > 9_223_372_036_854_775_807)
        transmute x
