/// A type conversion from a to b
trait Cast a b (e: effect) =
    cast: fn a -> b can e

impl cast_same: Cast a a pure with
    cast a = a

impl cast_ptr_usz: Cast (Ptr a) Usz pure with
    cast ptr = transmute ptr

impl cast_usz_ptr: Cast Usz (Ptr a) pure with
    cast address = transmute address

// Begin wall of casts
