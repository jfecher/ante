import Std.C.calloc
import Std.Stream.Stream, iter, stream_fn, Emit, emit
import Std.Hash.Hash
import Std.Fail.Fail, fail, panic_on_fail, or_panic, on_fail, try
import Std.Mem.Type, MkType, size_of, null, offset, deref_ptr, ptr_to_ref, array_insert
import Std.Iterator.repeat

export HashMap, Entry, Hash, HashMap.empty, HashMap.of, HashMap.clear, HashMap.resize, HashMap.should_resize,
    HashMap.insert, HashMap.get_entry, HashMap.get, HashMap.contains, HashMap.remove, HashMap.len,
    HashMap.is_empty, HashMap.keys, HashMap.values, HashMap.get_or_insert, HashMap.get_or_insert_with, HashMap.retain,
    HashMap.merge, HashMap.extend, print_hashmap, stream_map, stream_ref_map, eq_hashmap, clone_hashmap, extract_hashmap, insert_hashmap

/// A linear-scan mutable HashMap using a resize factor of 2.0
///
/// HashMaps store their Hash impl upon construction to ensure two HashMaps
/// used for merging, equality, etc. use the same impl.
type HashMap k v (h = _) =
    hasher: Hash k h
    len: Usz
    capacity: Usz
    entries: Ptr (Entry k v)

type Entry k v =
    key: k
    value: v
    occupied: Bool
    tombstone: Bool

/// Returns the length of this HashMap
HashMap.len (m: ref HashMap k v): Usz = m.len

/// Returns true if this HashMap is empty. Equivalent to `map.len () == 0`
HashMap.is_empty (m: ref HashMap k v): Bool = m.len == 0

/// Create a new, empty HashMap
/// This will not allocate until the first entry is inserted.
HashMap.empty () {hasher: Hash k h}: HashMap k v h = HashMap hasher 0 0 (null ())

/// Create a HashMap containing each `k, v` pair from the given stream.
HashMap.of (stream: s) {Stream s (k, v) e} {Hash k h} {Eq k e}: HashMap k v h can Panic, e =
    var map = HashMap.empty ()
    map.extend stream
    map

HashMap.extend (map: mut HashMap k v) (stream: s) {Stream s (k, v) e} {Eq k e}: Unit can Panic, e, Mutate 'map =
    iter stream (fn (k, v) -> map.insert k v)
 
HashMap.clear (map: mut HashMap k v) : Unit can Mutate 'map =
    if map.capacity != 0 then
        repeat map.capacity fn i ->
            entry = ptr_to_ref (offset map.entries i)
            entry.occupied := false
            entry.tombstone := false
        map.len := 0usz

HashMap.resize (map: mut HashMap k v) (new_capacity: Usz) {Eq k e}: Unit can Panic, e, Mutate 'map =
    if new_capacity > map.capacity then
        new_memory = calloc new_capacity (size_of (MkType : Type (Entry k v)))

        if new_memory == null () then
            panic "Ran out of memory while resizing HashMap"

        var new_map = HashMap map.hasher map.len new_capacity new_memory

        repeat map.capacity fn i ->
            entry: Entry k v = deref_ptr <| offset map.entries i
            if entry.occupied then
                new_map.insert entry.key entry.value

        map.capacity := new_capacity
        map.entries := new_memory

/// Should we resize this map when pushing another element?
HashMap.should_resize (map: ref HashMap k v) : Bool =
    scale_factor = 2
    (map.len + 1) * scale_factor > map.capacity

/// Inserts a key-value pair into the map, removing any item that may previously
/// have been associated with the same key and returning the removed value if there was one.
HashMap.insert (map: mut HashMap k v) (key: k) (value: v) {Eq k e}: Maybe v can Panic, e, Mutate 'map =
    if map.should_resize () then
        map.resize ((map.capacity + 1) * 2)

    var previous = Maybe.None
    var first_tombstone = Maybe.None
    var inserted = false
    var index = Usz (Hash.hash (deref (ref key)) {map.hasher}) % map.capacity
    var probes = 0usz

    while not inserted and probes < map.capacity do
        entry = ptr_to_ref (offset map.entries index)
        if entry.occupied then
            if key == entry.key then
                previous := Some (deref entry.value)
                entry := Entry (deref key) (deref value) true false
                inserted := true
        else if entry.tombstone then
            if first_tombstone is None then
                first_tombstone := Some index
        else
            insertion_index = first_tombstone.unwrap_or_else do index
            insertion_entry = ptr_to_ref (offset map.entries insertion_index)
            insertion_entry := Entry (deref key) (deref value) true false
            inserted := true

        index += 1
        if index == map.capacity then index := 0
        probes += 1

    if not inserted then
        match first_tombstone
        | Some tombstone ->
            array_insert map.entries tombstone (Entry (deref key) (deref value) true false)
        | None ->
            panic "Failed to insert entry into map"

    if previous is None then
        map.len := map.len + 1usz
    previous

HashMap.get_entry (map: ref 'm HashMap k v h) (key: ref k) {eq: Eq k e}: Maybe (ref 'm! (Entry k v)) can e =
    if map.capacity == 0 then return None

    var index = Usz (Hash.hash (deref key) {map.hasher}) % map.capacity
    var probes = 0usz

    while probes < map.capacity do
        entry_ptr = offset map.entries index
        entry = ptr_to_ref entry_ptr
        if entry.occupied then
            if entry.key == key then
                return Some (ptr_to_ref entry_ptr)
        else if not entry.tombstone then
            return None

        index += 1
        if index == map.capacity then index := 0
        probes += 1

    None

HashMap.get (map: ref 'm HashMap k v) (key: ref k) {Eq k e}: ref 'm! v can Fail, e =
    match map.get_entry key
    | Some entry -> entry.value
    | None -> fail ()

HashMap.contains (map: ref HashMap k v) (key: ref k) {Eq k e}: Bool can e =
    try (do map.get key) is Some _

HashMap.remove (map: mut HashMap k v) (key: ref k) {Eq k e} : Maybe v can e, Mutate 'map =
    match map.get_entry key
    | None -> None
    | Some entry ->
        entry.occupied := false
        entry.tombstone := true
        value = deref entry.value
        map.len := map.len - 1
        Some value

impl print_hashmap {Display k e} {Display v e}: Display (HashMap k v) e with
    print map =
        write "["
        var printed_first = false
        for i in 0 .. map.capacity do
            entry = ptr_to_ref (offset map.entries i)
            if entry.occupied then
                if printed_first then
                    print ", "

                print entry.key
                print " -> "
                print entry.value
                printed_first := true

        write "]"

impl stream_map: Stream (HashMap k v) (k, v) pure with
    stream map =
        for i in 0 .. map.capacity do
            entry = map.entries.[i]
            if entry.occupied then
                emit (deref entry.key, deref entry.value)

impl stream_ref_map: Stream (ref 'm HashMap k v) (ref 'm k, ref 'm v) pure with
    stream map =
        for i in 0 .. map.capacity do
            entry: ref 'm (Entry k v) = ptr_to_ref (offset map.entries i)
            if entry.occupied then
                key: ref 'm k = entry.key
                value: ref 'm v = entry.value
                emit (key, value)

/// Emit each key. Bit-copies the key; safe for `Copy` keys.
HashMap.keys (m: ref HashMap k v) = fn () can Emit k ->
    for i in 0 .. m.capacity do
        entry: Entry k v = deref_ptr (offset m.entries i)
        if entry.occupied then emit entry.key

/// Emit each value. Bit-copies the value; safe for `Copy` values.
HashMap.values (m: ref HashMap k v) = fn () can Emit v ->
    for i in 0 .. m.capacity do
        entry: Entry k v = deref_ptr (offset m.entries i)
        if entry.occupied then emit entry.value

/// Return the existing value at `key`, or insert `default` and return it.
HashMap.get_or_insert (m: mut 'm HashMap k v) (key: k) (default: v) {Eq k e} {Copy k}: ref 'm! v can Panic, e, Mutate 'm =
    m.get key ~> on_fail do
        ignore (m.insert key default)
        m.get key ~> or_panic "HashMap.get_or_insert: lookup after insert failed"

/// Same as `get_or_insert` but builds the default lazily.
HashMap.get_or_insert_with (m: mut 'm HashMap k v) (key: k) (mk: fn Unit => v) {Eq k e} {Copy k}: ref 'm! v can Panic, e, Mutate 'm =
    m.get key ~> on_fail do
        ignore (m.insert key (mk ()))
        m.get key ~> or_panic "HashMap.get_or_insert_with: lookup after insert failed"

/// Remove every entry for which `pred key value` returns false.
HashMap.retain (m: mut HashMap k v) (pred: fn k v => Bool) {Copy k} {Copy v}: Unit can Mutate 'm =
    for i in 0 .. m.capacity do
        entry_ptr = offset m.entries i
        entry = ptr_to_ref entry_ptr
        if entry.occupied then
            if not (pred entry.key entry.value) then
                entry.occupied := false
                entry.tombstone := true
                m.len -= 1

/// Insert every entry from `src` into `dst`, overwriting on conflict.
/// Both maps must hash their keys with the same `Hash` impl.
HashMap.merge (dst: mut HashMap k v h) (src: HashMap k v h) {Eq k e}: Unit can Panic, Mutate 'dst, e =
    iter src (fn (k, v) -> ignore (HashMap.insert dst k v))

impl extract_hashmap {Eq k e}: Extract (ref 'm HashMap k v) (ref k) (ref 'm! v) (Panic & e) with
    (.[]) map key = map.get key ~> panic_on_fail

impl insert_hashmap {Eq k e}: Insert (mut 'm HashMap k v) k v (Panic & Mutate 'm & e) with
    (.[]:=) map key value =
        map.insert key value
        ()

impl clone_hashmap {Clone k} {Clone v}: Clone (HashMap k v) with
    clone map =
        if map.capacity == 0 then
            return HashMap map.hasher 0 0 (null ())

        new_memory: Ptr (Entry k v) = calloc map.capacity (size_of (MkType : Type (Entry k v)))
        for i in 0 .. map.capacity do
            old = ptr_to_ref (offset map.entries i)
            new = ptr_to_ref (offset new_memory i)
            new.tombstone := old.tombstone
            if old.occupied then
                new := Entry (clone old.key) (clone old.value) true false
        HashMap map.hasher map.len map.capacity new_memory

impl eq_hashmap {Eq k e} {Eq v e}: Eq (HashMap k v) e with
    (==) map1 map2 =
        if map1.len () != map2.len () then
            return false

        for i in 0 .. map1.capacity do
            entry1 = ptr_to_ref (offset map1.entries i)
            if entry1.occupied then
                match map2.get_entry entry1.key
                | None -> return false
                | Some entry2 ->
                    if entry1.value != entry2.value then
                        return false
        true
