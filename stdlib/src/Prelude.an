type Maybe t =
   | None
   | Some t

/// If `condition` is true, returns `Some (then_ ())`,
/// otherwise returns `None`.
iff (condition: Bool) (then_: fn Unit => a): Maybe a =
    if condition then Some (then_ ()) else None

Maybe.unwrap (m: Maybe t): t can Panic =
    match m
    | Some x -> x
    | None -> panic "Tried to unwrap a None value"

Maybe.unwrap_or_else (m: Maybe t) (f: fn Unit => t): t =
    match m
    | Some x -> x
    | None -> f ()

// TODO: Temporarily an empty effect set rather than a built-in.
//       This being empty instead of a primitive incorrectly allows users to handle these effects.
/// Any file system-modifying action
effect Fs =

// TODO: Temporarily an empty effect set rather than a built-in.
//       This being empty instead of a primitive incorrectly allows users to handle these effects.
/// Any action connecting to a network
effect Net =

/// A convenience alias for the set of all primitive effects.
/// This may expand over time.
effect IO = Fs, Net

/// Mutating a place `'p`, which invalidates any reference to an unstable place within it like `'p!`.
/// This is performed by assigning through a `mut 'p` reference and cannot be handled.
effect Mutate 'p =

type Result t e =
   | Ok t
   | Error e

type (,) a b = first: a, second: b

first (a, _) = a
second (_, b) = b
third (_, _, c) = c
fourth (_, _, _, d) = d
fifth (_, _, _, _, e) = e

trait Append a =
    (++): fn a a -> a

(;) _ b = b
(|>) x f = f x
(<|) f x = f x

trait Extract collection index elem (e: effect) =
    (.[]): fn collection index -> elem can e

impl extract_ptr_usz: Extract (ref 'p Ptr t) Usz (ref 'p! t) pure with
    (.[]) ptr index = ptr_to_ref <| offset ptr.* index

impl extract_string: Extract (ref 's String) Usz (ref 's! Char) Panic with
    (.[]) s index =
        if index >= Usz s.length then
            panic "extract_string: character index out of bounds"
        ptr_to_ref <| offset s.data index

/// Dereference without a Copy constraint. This is unsafe to use directly
deref (x: ref t): t =
    intrinsic "Deref" x

trait Copy t =
    (.*): fn (ref t) -> t

trait Clone t =
    clone: fn (ref t) -> t

trait Drop t (e: effect) =
    drop: fn (mut t) -> Unit can e

impl copy_i8: Copy I8 with (.*) = deref
impl copy_i16: Copy I16 with (.*) = deref
impl copy_i32: Copy I32 with (.*) = deref
impl copy_i64: Copy I64 with (.*) = deref
impl copy_isz: Copy Isz with (.*) = deref
impl copy_u8: Copy U8 with (.*) = deref
impl copy_u16: Copy U16 with (.*) = deref
impl copy_u32: Copy U32 with (.*) = deref
impl copy_u64: Copy U64 with (.*) = deref
impl copy_usz: Copy Usz with (.*) = deref

impl copy_f32: Copy F32 with (.*) = deref
impl copy_f64: Copy F64 with (.*) = deref

impl copy_unit: Copy Unit with (.*) = deref
impl copy_bool: Copy Bool with (.*) = deref
impl copy_char: Copy Char with (.*) = deref

impl copy_ptr: Copy (Ptr t) with (.*) = deref
impl copy_ref: Copy (ref t) with (.*) = deref

impl copy_pair {Copy a} {Copy b}: Copy (a, b) with
    (.*) pair = (pair.first, pair.second)

impl copy_maybe {Copy a}: Copy (Maybe a) with
    (.*) m = match deref m
        | Some x -> Some (x.*)
        | None -> None

impl clone_i8: Clone I8 with clone = deref
impl clone_i16: Clone I16 with clone = deref
impl clone_i32: Clone I32 with clone = deref
impl clone_i64: Clone I64 with clone = deref
impl clone_isz: Clone Isz with clone = deref
impl clone_u8: Clone U8 with clone = deref
impl clone_u16: Clone U16 with clone = deref
impl clone_u32: Clone U32 with clone = deref
impl clone_u64: Clone U64 with clone = deref
impl clone_usz: Clone Usz with clone = deref
impl clone_f32: Clone F32 with clone = deref
impl clone_f64: Clone F64 with clone = deref
impl clone_unit: Clone Unit with clone = deref
impl clone_bool: Clone Bool with clone = deref
impl clone_char: Clone Char with clone = deref
impl clone_ptr: Clone (Ptr t) with clone = deref
impl clone_ref: Clone (ref t) with clone = deref

impl clone_pair {Clone a} {Clone b}: Clone (a, b) with
    clone pair = (clone pair.first, clone pair.second)

impl clone_maybe {Clone a}: Clone (Maybe a) with
    clone m = match m
        | Some x -> Some (clone x)
        | None -> None

impl drop_i8:  Drop I8  pure with drop _ = ()
impl drop_i16: Drop I16 pure with drop _ = ()
impl drop_i32: Drop I32 pure with drop _ = ()
impl drop_i64: Drop I64 pure with drop _ = ()
impl drop_isz: Drop Isz pure with drop _ = ()
impl drop_u8:  Drop U8  pure with drop _ = ()
impl drop_u16: Drop U16 pure with drop _ = ()
impl drop_u32: Drop U32 pure with drop _ = ()
impl drop_u64: Drop U64 pure with drop _ = ()
impl drop_usz: Drop Usz pure with drop _ = ()
impl drop_f32: Drop F32 pure with drop _ = ()
impl drop_f64: Drop F64 pure with drop _ = ()
impl drop_unit: Drop Unit pure with drop _ = ()
impl drop_bool: Drop Bool pure with drop _ = ()
impl drop_char: Drop Char pure with drop _ = ()
impl drop_ptr: Drop (Ptr t) pure with drop _ = ()

/// Insert an element into a collection.
trait Insert collection index elem (e: effect) =
    (.[]:=): fn collection index elem -> Unit can e

impl insert_ptr_usz: Insert (mut 'p Ptr t) Usz t pure with
    (.[]:=) ptr index value = ptr_store (offset ptr.* index) value

effect Panic =
    panic: fn String -> Never

abort_on_panic (f: a can Panic, e): a can e =
    handle f ()
    | panic msg ->
        dbg msg
        exit 1
        // Unreachable, return any type
        deref_ptr (null ())

ignore _x = ()
