import Std.C.putchar

export Print, Print.write, write, Print.write_char, write_char, Print.write_u64, write_u64, Print.write_i64, write_i64, Print.write_f64, write_f64,
    print_to_sink, print_to_stdout, print_to_stderr, dbg, Display, print, println, print_u8, print_u16, print_u32, print_u64, print_usz, print_i8, print_i16, print_i32, print_i64, print_isz, print_char, print_f64, print_f32, print_pair, print_string, print_maybe, print_bool, print_ref

effect Print =
    write: fn (ref String) -> Unit
    write_char: fn Char -> Unit
    write_u64: fn U64 -> Unit
    write_i64: fn I64 -> Unit
    write_f64: fn F64 -> Unit

write_stdout: fn (Ptr Char) Usz -> Unit can Fs = extern "ante_write_stdout"
write_stderr: fn (Ptr Char) Usz -> Unit can Fs = extern "ante_write_stderr"

/// Forwards each printed string to the given function expecting a string pointer
/// and the length in bytes of that string pointer.
print_to_sink (sink: fn (Ptr Char) Usz => Unit can Fs) (f: a can Print, e): a can Fs, e =
    write_string (s: String) = sink s.data (Usz s.length)
    handle f ()
    | write s -> resume (sink s.data (Usz s.length))
    | write_char c -> resume (write_string "${c}")
    | write_u64 x -> resume (write_string "${x}")
    | write_i64 x -> resume (write_string "${x}")
    | write_f64 x -> resume (write_string "${x}")

/// Handles `Print` by piping to stdout
print_to_stdout (f: a can Print, e): a can Fs, e =
    print_to_sink write_stdout f

/// Handles `Print` by piping to stderr
print_to_stderr (f: a can Print, e): a can Fs, e =
    print_to_sink write_stderr f

/// Display the given String to stderr without using any effects.
/// 
/// This function is intended for debugging purposes. Because it
/// appears pure to the compiler, there is no guarantee it won't be
/// optimized out of the program.
dbg (s: String): Unit =
    write_stderr: fn (Ptr Char) Usz -> Unit = extern "ante_write_stderr"
    write_stderr s.data (Usz s.length)
    write_stderr "\n".data 1

trait Display t (e: effect) =
    print: fn (ref t) -> Unit can Print, e

println (x: ref t) {Display t e} =
    print x
    write_char '\n'

impl print_i8: Display I8 pure with
    print x = write_i64 (I64 x.*)
impl print_i16: Display I16 pure with
    print x = write_i64 (I64 x.*)
impl print_i32: Display I32 pure with
    print x = write_i64 (I64 x.*)
impl print_i64: Display I64 pure with
    print x = write_i64 x.*

impl print_u8: Display U8 pure with
    print x = write_u64 (U64 x.*)
impl print_u16: Display U16 pure with
    print x = write_u64 (U64 x.*)
impl print_u32: Display U32 pure with
    print x = write_u64 (U64 x.*)
impl print_u64: Display U64 pure with
    print x = write_u64 x.*
impl print_usz: Display Usz pure with
    print x = write_u64 (U64 x.*)

// TODO: This is broken for non-64-bit platforms.
impl print_isz: Display Isz pure with
    print x = write_i64 (I64 x.*)

impl print_char: Display Char pure with
    print x = write_char x.*

impl print_f64: Display F64 pure with
    print x = write_f64 x.*
impl print_f32: Display F32 pure with
    print x = write_f64 (F64 x.*)

impl print_pair {Display a e} {Display b e}: Display (a, b) e with
    print pair =
        // TODO: Parenthesization for nested pairs while keeping `a, (b, (c, d))` unparenthesized
        print pair.first
        print ", "
        print pair.second

impl print_string: Display String pure with
    print s = write s

impl print_maybe {Display a e}: Display (Maybe a) e with
    print m =
        match deref m
        | Some a ->
            print "Some "
            // TODO: Parenthesize if necessary
            print a
        | None -> print "None"

impl print_bool: Display Bool pure with
    print b =
        if b.* then print "true"
        else print "false"

impl print_ref {Display a e}: Display (ref a) e with
    print x = print x.*
